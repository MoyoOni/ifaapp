# Staging Environment Configuration
# Copy this to .env.staging and fill in values
# Usage: docker-compose -f docker-compose.staging.yml --env-file .env.staging up

# ============================================
# INFRASTRUCTURE & DEPLOYMENT
# ============================================
NODE_ENV=production
LOG_LEVEL=info
ENVIRONMENT=staging

# ============================================
# DATABASE
# ============================================
# PostgreSQL 16 - Staging Instance
POSTGRES_DB=ilu_ase_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=CHANGE_ME_random_secure_password
DATABASE_URL=postgresql://staging_user:CHANGE_ME_random_secure_password@postgres:5432/ilu_ase_staging?schema=public&connection_limit=10

# ============================================
# REDIS CACHE
# ============================================
# Redis - Session store & cache
REDIS_PASSWORD=CHANGE_ME_random_secure_redis_password
REDIS_URL=redis://:CHANGE_ME_random_secure_redis_password@redis:6379

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT - Minimum 32 characters
JWT_SECRET=CHANGE_ME_minimum_32_characters_random_secure_jwt_secret_key
JWT_EXPIRATION=3600

# ============================================
# PAYMENT PROCESSING
# ============================================
# Stripe - Use TEST/sandbox keys for staging
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET

# ============================================
# ERROR TRACKING & MONITORING
# ============================================
# Sentry - Error tracking (optional for staging, but recommended)
SENTRY_DSN=https://YOUR_SENTRY_KEY@YOUR_SENTRY_ORG.ingest.sentry.io/YOUR_PROJECT_ID
SENTRY_ENVIRONMENT=staging
SENTRY_TRACE_SAMPLE_RATE=0.5
SENTRY_ENABLED=true

# ============================================
# URLS & ORIGINS
# ============================================
# API & Frontend endpoints (for staging with docker-compose)
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4040
WEBSOCKET_URL=ws://localhost:8080
WEBSOCKET_CORS_ORIGIN=http://localhost:4040

# ============================================
# API DOCUMENTATION
# ============================================
# Swagger
ENABLE_SWAGGER=true
SWAGGER_PATH=/api/docs

# ============================================
# OPTIONAL: FILE UPLOADS & STORAGE
# ============================================
# AWS S3 (optional, for production use)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
# AWS_S3_BUCKET=ilu-ase-staging

# ============================================
# OPTIONAL: EMAIL SERVICE
# ============================================
# SendGrid or similar (optional, configure in production)
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY
# SENDGRID_FROM_EMAIL=noreply@ilu-ase.com

# ============================================
# OPTIONAL: PUSH NOTIFICATIONS
# ============================================
# FCM or similar (optional, configure in production)
# FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# ============================================
# SEED DATA (Optional - for QA testing)
# ============================================
# Set to "true" to auto-seed demo data on startup
SEED_DATABASE=false
