// ─── V8: Monetisation Models ─────────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(ACTIVE)
  paystackSubId      String?            @unique
  paystackRef        String? // transaction reference
  // HUMAN_BACKLOG.md: Paystack's /subscription/disable requires both the
  // subscription_code AND this email_token from the subscription.create
  // webhook -- without it stored, cancellation can't actually reach Paystack.
  paystackEmailToken String?
  startDate          DateTime
  endDate            DateTime
  autoRenew          Boolean            @default(true)
  amountPaid         Int // in kobo (₦25,000 = 2500000)
  currency           String             @default("NGN")
  reminderSent       Boolean            @default(false)
  // V8-503: one free 30-day pause per subscription lifetime (this row spans
  // renewals -- charge.success extends endDate in place rather than creating
  // a new row -- so this flag is never reset by a renewal, only by a fresh
  // subscribe after cancellation, which does create a new row).
  pausedAt           DateTime?
  // V8-504: dedupe flag so the daily win-back sweep never emails the same
  // lapsed subscription twice. Set once the win-back email actually sends.
  winBackSentAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([paystackSubId])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  profileId String
  viewedAt  DateTime @default(now())

  viewer  User @relation("ProfileViewGiver", fields: [viewerId], references: [id], onDelete: Cascade)
  profile User @relation("ProfileViewReceiver", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId]) // one row per viewer-profile pair (updated on revisit)
  @@index([profileId, viewedAt])
  @@index([viewerId])
  @@map("profile_views")
}

model Referral {
  id                        String   @id @default(cuid())
  referrerId                String
  referredId                String   @unique // each user can only be referred once
  code                      String
  // EXP-027's ₦500-wallet-credit-on-first-completed-booking reward
  // (appointments.service.ts maybeGrantReferralReward).
  rewardGranted             Boolean  @default(false)
  // V8-501: the separate 30-free-Devoted-days reward on the referred user's
  // first subscription (subscriptions.service.ts rewardReferrer). Was
  // previously sharing `rewardGranted` with the booking reward above --
  // whichever milestone (first booking vs. first subscribe) happened first
  // silently consumed the flag and the other reward never paid out. Each
  // reward now has its own independent flag.
  subscriptionRewardGranted Boolean  @default(false)
  createdAt                 DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ADM-012: Refund Request Management
model RefundRequest {
  id             String    @id @default(uuid())
  requestedBy    String
