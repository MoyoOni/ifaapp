// Whole-app audit loose end: real like/comment backing for the Like/Comment
// buttons on circle feed posts (previously no onClick at all -- CircleFeedPost's
// `likes`/`commentCount` were already denormalized counters with nothing
// writing to them). A join table (not a bare increment) so a like can be
// toggled/undone and the same user can't double-like a post.
model CircleFeedLike {
  id        String         @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime       @default(now())
  post      CircleFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User           @relation("CircleFeedLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
