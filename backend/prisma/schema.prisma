  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  adminNote      String?
  approvedAmount Decimal?  @db.Decimal(14, 2) // actual amount approved (may differ from requested)
  processedBy    String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requester User  @relation("RefundRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  processor User? @relation("RefundProcessor", fields: [processedBy], references: [id])

  @@index([requestedBy])
  @@index([status])
  @@index([orderId])
  @@index([appointmentId])
  @@index([createdAt])
}

