  journey     SpiritualJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([category])
  @@index([date])
}

model JourneyReflection {
  id        String           @id @default(uuid())
  journeyId String
  title     String?
  content   String
  mood      String?
  tags      String[]
  isPrivate Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  journey   SpiritualJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([createdAt])
  @@index([isPrivate])
}

model AdvisoryVote {
  id               String               @id @default(cuid())
  title            String
  description      String
  proposerId       String
  deadline         DateTime
  requiredMajority RequiredMajority
  status           VoteStatus
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  casts            AdvisoryVoteCast[]
  options          AdvisoryVoteOption[]
  proposer         User                 @relation("ProposedVotes", fields: [proposerId], references: [id])

  @@map("advisory_votes")
}

model AdvisoryVoteOption {
  id        String       @id @default(cuid())
  option    String
  voteId    String
  voteCount Int          @default(0)
  vote      AdvisoryVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@map("advisory_vote_options")
}

model AdvisoryVoteCast {
  id        String       @id @default(cuid())
  userId    String
  voteId    String
  option    String
  createdAt DateTime     @default(now())
  user      User         @relation("CastVotes", fields: [userId], references: [id])
  vote      AdvisoryVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([userId, voteId])
  @@map("advisory_vote_casts")
}

model Payment {
  id            String    @id @default(uuid())
  userId        String
  transactionId String    @unique
  amount        Float
  currency      String    @default("NGN")
  purpose       String
  provider      String
  status        String    @default("PENDING")
  metadata      Json?
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@index([status])
  @@index([verified])
}

enum RequiredMajority {
  SIMPLE
  SUPER
  UNANIMOUS
}

enum VoteStatus {
  PENDING
  ACTIVE
  CLOSED
  APPROVED
  REJECTED
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  action         String
  resourceType   String
  resourceId     String?
  previousValues Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, action])
  @@map("audit_logs")
}

// ─── V8: Monetisation Models ─────────────────────────────────────────────────

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(ACTIVE)
  paystackSubId   String?            @unique
  paystackRef     String?            // transaction reference
  startDate       DateTime
  endDate         DateTime
  autoRenew       Boolean            @default(true)
  amountPaid      Int                // in kobo (₦25,000 = 2500000)
  currency        String             @default("NGN")
  reminderSent    Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([paystackSubId])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  profileId String
  viewedAt  DateTime @default(now())

  viewer  User @relation("ProfileViewGiver",    fields: [viewerId],  references: [id], onDelete: Cascade)
  profile User @relation("ProfileViewReceiver", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId]) // one row per viewer-profile pair (updated on revisit)
  @@index([profileId, viewedAt])
  @@index([viewerId])
  @@map("profile_views")
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredId     String   @unique // each user can only be referred once
  code           String
  rewardGranted  Boolean  @default(false)
  createdAt      DateTime @default(now())

  referrer User @relation("ReferralsMade",    fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ADM-012: Refund Request Management
model RefundRequest {
  id            String    @id @default(uuid())
  requestedBy   String
  orderId       String?
  appointmentId String?
  amount        Float?    // null = full refund
  reason        String
  evidence      String[]  @default([])
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  adminNote     String?
  approvedAmount Float?   // actual amount approved (may differ from requested)
  processedBy   String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requester User  @relation("RefundRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  processor User? @relation("RefundProcessor", fields: [processedBy], references: [id])

  @@index([requestedBy])
  @@index([status])
  @@index([orderId])
  @@index([appointmentId])
  @@index([createdAt])
}

// ADM-005: Platform Announcement System
model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  type        String    // BANNER | NOTIFICATION | EMAIL_BROADCAST
  target      String    // ALL | CLIENT | BABALAWO | VENDOR | DEVOTED | SPECIFIC
  targetIds   String[]  @default([])
  status      String    @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | EXPIRED
  scheduledAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User      @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@index([createdBy])
  @@index([scheduledAt])
}

// ADM-008: Practitioner Complaint Handling
model PractitionerComplaint {
  id              String    @id @default(uuid())
  clientId        String
  practitionerId  String
  reason          String    // NO_SHOW | INAPPROPRIATE | FRAUD | OTHER
  description     String
  evidence        String[]  @default([])
  status          String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  resolution      String?
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          User      @relation("ClientComplaint", fields: [clientId], references: [id], onDelete: Cascade)
  practitioner    User      @relation("PractitionerComplaint", fields: [practitionerId], references: [id], onDelete: Cascade)
  resolvedBy      User?     @relation("ResolverComplaint", fields: [resolvedById], references: [id])

  @@index([clientId])
  @@index([practitionerId])
  @@index([status])
  @@index([createdAt])
}

// F9-806: Àṣẹ Live audio space
model LiveSession {
  id           String    @id @default(uuid())
  title        String
  hostIds      String[]
  scheduledAt  DateTime
  platform     String
  externalUrl  String
  preThreadId  String?
  recordingUrl String?
  status       String    @default("SCHEDULED")
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model OralHistoryEntry {
  id             String   @id @default(uuid())
  title          String
  category       String
  babalawoName   String?
  recordingDate  DateTime?
  tags           String[] @default([])
  content        String
  sourceUrl      String?
  publishedAt    DateTime?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator        User     @relation("OralHistoryCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([createdAt])
  @@index([publishedAt])
}

model SacredCalendarEvent {
  id           String   @id @default(uuid())
  title        String
  yorubaName   String?
  description  String
  date         DateTime
  endDate      DateTime?
  type         String   @default("FESTIVAL")
  bannerColor  String?
  isActive     Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator      User     @relation("SacredCalendarCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([isActive])
}

model PlatformSettings {
  id                           String   @id @default("singleton")
  consultationCommissionPct    Float    @default(15)
  marketplaceCommissionPct     Float    @default(10)
  minPayoutThresholdNgn        Float    @default(5000)
  maxPayoutWithoutApprovalNgn  Float    @default(100000)
  quizPassThreshold            Int      @default(2)
  updatedAt                    DateTime @updatedAt
  updatedBy                    String?
}

// ADM-028: Cultural Orientation Quiz
model CulturalQuizQuestion {
  id           String   @id @default(uuid())
  questionText String
  options      Json     // String[]
  correctIndex Int
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("cultural_quiz_questions")
}

// ADM-017: Community Recognition System
model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeKey   String   // Unique identifier for the badge type
  awardedAt  DateTime @default(now())
  awardedById String?
  reason     String?
  
  user      User     @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User?    @relation("BadgeAwarder", fields: [awardedById], references: [id])

  @@index([userId])
  @@index([badgeKey])
}

// EXP-012: Onboarding completion email tracking
model OnboardingEmail {
  id      String   @id @default(uuid())
  userId  String
  email   String   // Store email at time of sending (in case user changes it later)
  sentAt  DateTime @default(now())

  user User @relation("OnboardingEmailUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
}

// ADM-018: Cultural Integrity Review Queue
model ContentFlagRule {
  id        String   @id @default(uuid())
  type      String   // KEYWORD | CATEGORY_MOD
  value     String   // keyword text OR categoryId
  reason    String?
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User     @relation("FlagRuleCreator", fields: [createdBy], references: [id])

  @@index([type, isActive])
}

// ADM-019: Segmented Email Campaigns
model EmailCampaign {
  id             String    @id @default(uuid())
  subject        String
  body           String
  segment        String    // ALL | CLIENTS | BABALAWOS | DEVOTED | FREE_TIER | NEW_30D | INACTIVE_30D | COUNTRY_NG | COUNTRY_UK | COUNTRY_US
  status         String    @default("DRAFT") // DRAFT | SENT | SCHEDULED
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator        User      @relation("CampaignCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([createdAt])
}

// ADM-020: Promo Code & Discount System
model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String    // PCT_SUBSCRIPTION | FIXED_CONSULTATION | FREE_TRIAL_DAYS | REFERRAL_CREDIT
  value          Float
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  eligibleRoles  String[]  @default([])
  isActive       Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator        User      @relation("PromoCodeCreator", fields: [createdBy], references: [id])
  redemptions    PromoRedemption[]

  @@index([code])
  @@index([isActive])
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime  @default(now())
  discountNgn Float     @default(0)

  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation("PromoRedemptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([userId])
}

// ADM-021: Referral Program Management uses the existing Referral model above

// ADM-027: Session & Security Management
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceInfo  String?
  location    String?
  loginAt     DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  loggedOutAt DateTime?
  isActive    Boolean   @default(true)
  success     Boolean   @default(true)
  failReason  String?

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("user_sessions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  role      String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([userId])
}
