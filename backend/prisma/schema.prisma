generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  phone                     String?                  @unique
  whatsappNumber            String?
  whatsappEnabled           Boolean                  @default(true)
  fcmTokens                 String[]                 @default([])
  googleId                  String?                  @unique
  name                      String
  passwordHash              String
  role                      String
  permissions               String[]                 @default([]) // D6: granular RBAC
  yorubaName                String?
  avatar                    String?
  bio                       String?
  aboutMe                   String?
  gender                    String?
  age                       Int?
  location                  String?
  timezone                  String?                  @default("UTC")
  culturalLevel             String                   @default("Omo Ilé")
  rankXP                    Int                      @default(0)
  dialectPreference         String?
  themeColor                String?
  profileVisibility         String                   @default("community")
  interests                 String[]                 @default([])
  intentTags                String[]                 @default([])
  verified                  Boolean                  @default(false)
  emailVerificationToken    String?                  @unique
  emailVerifiedAt           DateTime?
  hasOnboarded              Boolean                  @default(false)
  slug                      String?                  @unique
  adminSubRole              String? // FINANCE, MODERATOR, COMPLIANCE, SUPPORT, SUPER
  templeId                  String?
  averageRating             Float?                   @default(0.0)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  availability              Json?
  appointmentsAsBabalawo    Appointment[]            @relation("BabalawoAppointments")
  appointmentsAsClient      Appointment[]            @relation("ClientAppointments")
  babalawoClients           BabalawoClient[]         @relation("BabalawoRelationships")
  clientsAsBabalawo         BabalawoClient[]         @relation("ClientRelationships")
  babalawoReviews           BabalawoReview[]         @relation("BabalawoReviewClient")
  babalawoReviewsReceived   BabalawoReview[]         @relation("BabalawoReviewBabalawo")
  certificates              Certificate[]
  circlesApproved           Circle[]                 @relation("CircleApprover")
  circlesCreated            Circle[]                 @relation("CircleCreator")
  circlesSuggested          Circle[]                 @relation("CircleSuggester")
  circleFeedPosts           CircleFeedPost[]         @relation("CircleFeedAuthor")
  circleMemberships         CircleMember[]           @relation("CircleMembers")
  circleSuggestionsReviewed CircleSuggestion[]       @relation("CircleReviewer")
  circleSuggestions         CircleSuggestion[]       @relation("CircleSuggester")
  coursesInstructed         Course[]                 @relation("CourseInstructor")
  courseReviewsGiven        CourseReview[]           @relation("CourseReviewStudent")
  deviceTokens              DeviceToken[]            @relation("DeviceTokens")
  disputesAsComplainant     Dispute[]                @relation("DisputesAsComplainant")
  disputesAsRespondent      Dispute[]                @relation("DisputesAsRespondent")
  sharedDocuments           Document[]               @relation("SharedDocuments")
  documents                 Document[]               @relation("UploadedDocuments")
  enrollments               Enrollment[]             @relation("EnrollmentStudent")
  escrows                   Escrow[]                 @relation("EscrowUser")
  eventsCreated             Event[]                  @relation("EventCreator")
  eventRegistrations        EventRegistration[]      @relation("EventRegistrations")
  postsAuthored             ForumPost[]              @relation("PostAuthor")
  threadsAuthored           ForumThread[]            @relation("ThreadAuthor")
  threadsLastPoster         ForumThread[]            @relation("ThreadLastPoster")
  forumBookmarks            ForumBookmark[]
  forumReports              ForumReport[]    @relation("ForumReporter")
  forumSubscriptions        ForumSubscription[]
  elderFlagsCreated         ElderFlag[]              @relation("ElderFlagsCreated")
  elderFlagsReviewed        ElderFlag[]              @relation("ElderFlagsReviewed")
  tipsGiven                 ForumTip[]               @relation("TipsGiven")
  tipsReceived              ForumTip[]               @relation("TipsReceived")
  elderReactions            ElderReaction[]          @relation("ElderReactions")
  guidancePlansCreated      GuidancePlan[]           @relation("GuidancePlanBabalawo")
  guidancePlansReceived     GuidancePlan[]           @relation("GuidancePlanClient")
  guidancePlanTemplates     GuidancePlanTemplate[]   @relation("GuidancePlanTemplates")
  receivedMessages          Message[]                @relation("ReceivedMessages")
  sentMessages              Message[]                @relation("SentMessages")
  notifications             Notification[]           @relation("NotificationRecipient")
  ordersPlaced              Order[]                  @relation("OrderCustomer")
  payments                  Payment[]
  auditLogs                 AuditLog[]               @relation("UserAuditLogs")
  postAcknowledgments       PostAcknowledgment[]     @relation("PostAcknowledgments")
  productReviews            ProductReview[]          @relation("ReviewCustomer")
  socialLinks               SocialLink[]
  userJourney               SpiritualJourney?        @relation("SpiritualJourneyUser")
  templesFounded            Temple?                  @relation("TempleFounder")
  templeFollows             TempleFollow[]           @relation("TempleFollows")
  transactions              Transaction[]            @relation("TransactionUser")
  tutorProfile              Tutor?                   @relation("TutorUser")
  tutorSessions             TutorSession[]           @relation("TutorSessions")
  wordHistories             UserWordHistory[]        @relation("UserWordHistory")
  vendorProfile             Vendor?
  verificationApp           VerificationApplication?
  userWallet                Wallet?                  @relation("WalletUser")
  withdrawalRequests        WithdrawalRequest[]      @relation("WithdrawalUser")
  castVotes                 AdvisoryVoteCast[]       @relation("CastVotes")
  proposedVotes             AdvisoryVote[]           @relation("ProposedVotes")
  templesJoined             Temple[]                 @relation("TempleMembers")
  subscriptions             Subscription[]           @relation("UserSubscriptions")
  profileViewsGiven         ProfileView[]            @relation("ProfileViewGiver")
  profileViewsReceived      ProfileView[]            @relation("ProfileViewReceiver")
  referralsMade             Referral[]               @relation("ReferralsMade")
  referralReceived          Referral?                @relation("ReferralReceived")

  // Subscription / billing fields
  subscriptionStatus        String                   @default("FREE") // FREE | DEVOTED | EXPIRED
  subscriptionEnd           DateTime?
  referralCode              String?                  @unique

  // F9-702: Forum digest email opt-in
  forumDigestOptIn          Boolean                  @default(true)

  // F9-703: Community Builder badge
  isCommunityBuilder        Boolean                  @default(false)

  // F9-802: Participation streak
  contributionStreak        Int                      @default(0)
  lastContributionDate      DateTime?
  longestStreak             Int                      @default(0)

  // F9-901: Practitioner Trust Score
  trustScore                Float                    @default(0.5) // 0.0 - 1.0, default is neutral
  trustScoreOverride        Float?
  trustScoreOverrideReason  String?
  trustScoreOverrideBy      String?
  trustScoreOverrideAt      DateTime?
  passedCulturalOrientation Boolean                  @default(false)
  culturalQuizFailCount     Int                      @default(0)
  // F9-10: Inactive Practitioner Re-engagement
  isOnLeave                 Boolean                  @default(false)
  isDeactivated             Boolean                  @default(false)

  // ADM-003: Suspension & Ban
  suspendedUntil            DateTime?
  bannedAt                  DateTime?
  banReason                 String?
  warnedAt                  DateTime?
  warnCount                 Int                      @default(0)

  // ADM-007: Featured Practitioners
  isFeatured                Boolean                  @default(false)
  featuredOrder             Int?
  featuredExpiry            DateTime?

  // Reverse relations for new admin models
  announcements             Announcement[]           @relation("AnnouncementCreator")
  complaintsAsClient        PractitionerComplaint[]  @relation("ClientComplaint")
  complaintsAsPractitioner  PractitionerComplaint[]  @relation("PractitionerComplaint")
  resolvedComplaints        PractitionerComplaint[]  @relation("ResolverComplaint")
  refundRequestsMade        RefundRequest[]          @relation("RefundRequester")
  refundRequestsProcessed   RefundRequest[]          @relation("RefundProcessor")
  oralHistoryEntries        OralHistoryEntry[]       @relation("OralHistoryCreator")
  sacredCalendarEvents      SacredCalendarEvent[]    @relation("SacredCalendarCreator")

  // EXP-020: Personal Awo relationship
  personalAwoId             String?
  personalAwo               User?                    @relation("PersonalAwoClients", fields: [personalAwoId], references: [id])
  personalAwoClients        User[]                   @relation("PersonalAwoClients")
  
  // EXP-024: Consultation Notes relations
  babalawoNotes             ConsultationNote[]       @relation("BabalawoNotes")
  clientNotes               ConsultationNote[]       @relation("ClientNotes")
  
  // EXP-023: Client Session Notes
  clientSessionNotes        ClientSessionNote[]      @relation("ClientSessionNotes")
  
  // EXP-026: Notification Preferences
  userNotificationPreferences   NotificationPreferences? @relation("UserNotificationPreferences")
  notificationPreferencesId     String?                  @unique
  
  onboardingEmails          OnboardingEmail[]        @relation("OnboardingEmailUser")

  // Additional relations for other models
  userBadges                UserBadge[]              @relation("UserBadges")
  badgeAwarder              UserBadge[]              @relation("BadgeAwarder")
  flagRuleCreator           ContentFlagRule[]        @relation("FlagRuleCreator")
  campaignCreator           EmailCampaign[]          @relation("CampaignCreator")
  promoCodeCreator          PromoCode[]              @relation("PromoCodeCreator")
  promoRedemptions          PromoRedemption[]        @relation("PromoRedemptions")
  userSessions              UserSession[]            @relation("UserSessions")

  @@map("users")
}

model NotificationPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailBooking        Boolean  @default(true)
  emailReminder       Boolean  @default(true)
  emailDigest         Boolean  @default(false)
  emailPlan           Boolean  @default(true)
  emailMessages       Boolean  @default(true)
  emailMarketing      Boolean  @default(false)
  pushReminder        Boolean  @default(true)
  pushMessages        Boolean  @default(true)
  pushFollowup        Boolean  @default(true)
  pushForum           Boolean  @default(false)
  pushCircles         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user                User     @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialLink {
  id       String @id @default(uuid())
  userId   String
  platform String
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  title     String
  issuer    String
  date      String
  tier      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationApplication {
  id                 String                @id @default(uuid())
  userId             String                @unique
  lineage            String
  mentorEndorsements String[]
  yearsOfService     Int
  documentation      String[]
  specialization     String[]
  languages          String[]
  currentStage       String                @default("APPLICATION")
  tier               String?
  submittedAt        DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  approvedAt         DateTime?
  approvedById       String?
  rejectedAt         DateTime?
  rejectedById       String?
  rejectionReason    String?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history            VerificationHistory[]

  @@index([userId])
  @@index([currentStage])
}

model VerificationHistory {
  id            String                  @id @default(uuid())
  applicationId String
  stage         String
  status        String
  reviewerId    String?
  notes         String?
  timestamp     BigInt
  application   VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model BabalawoClient {
  id                      String    @id @default(uuid())
  babalawoId              String
  clientId                String
  status                  String    @default("ACTIVE")
  notes                   String?
  assignedAt              DateTime  @default(now())
  changedAt               DateTime?
  covenantAgreed          Boolean   @default(false)
  covenantText            String?
  durationMonths          Int?
  endDate                 DateTime?
  exclusivityAcknowledged Boolean   @default(false)
  expiredAt               DateTime?
  gracePeriodEnd          DateTime?
  gracePeriodStart        DateTime?
  inGracePeriod           Boolean   @default(false)
  relationshipType        String    @default("ONE_OFF")
  renewalPromptSentAt     DateTime?
  renewalPrompted         Boolean   @default(false)
  startDate               DateTime?
  babalawo                User      @relation("BabalawoRelationships", fields: [babalawoId], references: [id], onDelete: Cascade)
  client                  User      @relation("ClientRelationships", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([babalawoId, clientId])
  @@index([babalawoId])
  @@index([clientId])
  @@index([status])
  @@index([relationshipType])
  @@index([endDate])
  @@index([inGracePeriod])
}

model Message {
  id             String    @id @default(uuid())
  senderId       String
  receiverId     String
  content        String
  encrypted      Boolean   @default(true)
  read           Boolean   @default(false)
  attachments    Json?
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  autoDeleteAt   DateTime?
  autoDeleteDays Int?
  confidential   Boolean   @default(false)
  deletedAt      DateTime?
  privacyLevel   String    @default("PRIVATE")
  receiver       User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([createdAt])
  @@index([autoDeleteAt])
  @@index([confidential])
  @@index([privacyLevel])
}

model Document {
  id               String    @id @default(uuid())
  uploadedBy       String
  sharedWith       String
  type             String
  filename         String
  originalFilename String
  size             Int
  mimeType         String
  s3Key            String
  signedUrl        String?
  urlExpiresAt     DateTime?
  description      String?
  scanned          Boolean   @default(false)
  scanMethod       String?
  scanTimestamp    DateTime?
  threatDetected   Boolean?
  threatName       String?
  encrypted        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime? // P0-03: soft delete — Document had no existing
                             // state field to reuse (unlike ForumThread/Circle's
                             // `status`), so this is a real additive column.
  sharer           User      @relation("SharedDocuments", fields: [sharedWith], references: [id], onDelete: Cascade)
  uploader         User      @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy, sharedWith])
  @@index([s3Key])
  @@index([deletedAt])
}

model Appointment {
  id           String        @id @default(uuid())
  babalawoId   String
  clientId     String
  date         String
  time         String
  timezone     String        @default("Africa/Lagos")
  duration     Int           @default(60)
  status       String        @default("UPCOMING")
  price        Float?
  notes        String?
  cancelledAt  DateTime?
  cancelledBy  String?
  isPriority   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  recordingUrl String?
  videoRoomId  String?
  videoToken   String?
  topic        String?
  babalawo     User          @relation("BabalawoAppointments", fields: [babalawoId], references: [id], onDelete: Cascade)
  client       User          @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  guidancePlan GuidancePlan?
  
  // EXP-023: Client Session Notes
  clientSessionNotes ClientSessionNote[]

  @@index([babalawoId])
  @@index([clientId])
  @@index([date])
  @@index([status])
}

model ConsultationNote {
  id         String   @id @default(cuid())
  babalawoId String
  clientId   String
  title      String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  babalawo User @relation("BabalawoNotes", fields: [babalawoId], references: [id], onDelete: Cascade)
  client   User @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([babalawoId])
  @@index([clientId])
  @@index([createdAt])
}

model ClientSessionNote {
  id            String      @id @default(cuid())
  appointmentId String
  clientId      String
  title         String?
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      User        @relation("ClientSessionNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([clientId])
  @@index([createdAt])
}

model GuidancePlan {
  id                 String      @id @default(uuid())
  appointmentId      String      @unique
  babalawoId         String
  clientId           String
  type               String      @default("AKOSE")
  items              Json
  totalCost          Float
  platformServiceFee Float       @default(100)
  currency           String      @default("NGN")
  instructions       String?
  status             String      @default("PENDING")
  escrowId           String?     @unique
  approvedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  notes              String?
  completedItems     String[]    @default([])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  babalawo           User        @relation("GuidancePlanBabalawo", fields: [babalawoId], references: [id], onDelete: Cascade)
  client             User        @relation("GuidancePlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  escrow             Escrow?     @relation(fields: [escrowId], references: [id])

  @@index([appointmentId])
  @@index([babalawoId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([babalawoId, status])
  @@index([clientId, status])
}

model GuidancePlanTemplate {
  id           String   @id @default(uuid())
  babalawoId   String
  name         String
  type         String   @default("AKOSE")
  items        Json
  instructions String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  babalawo     User     @relation("GuidancePlanTemplates", fields: [babalawoId], references: [id], onDelete: Cascade)

  @@index([babalawoId])
}

model ForumCategory {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  icon        String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  isTeachings Boolean       @default(false)
  threadCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threads     ForumThread[]

  @@index([slug])
  @@index([isActive])
}

model ForumThread {
  id                     String            @id @default(uuid())
  categoryId             String
  authorId               String
  title                  String
  content                String
  tags                   String[]
  status                 String            @default("ACTIVE")
  isPinned               Boolean           @default(false)
  isLocked               Boolean           @default(false)
  isApproved             Boolean           @default(true)
  isSacred               Boolean           @default(false)
  isFeatured             Boolean           @default(false)
  featuredUntil          DateTime?
  viewCount              Int               @default(0)
  postCount              Int               @default(0)
  lastPostAt             DateTime?
  lastPostBy             String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  circleSuggestionThread Circle?           @relation("CircleSuggestionThread")
  circleSuggestion       CircleSuggestion?
  posts                  ForumPost[]
  bookmarks              ForumBookmark[]
  subscriptions          ForumSubscription[]
  author                 User              @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category               ForumCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lastPoster             User?             @relation("ThreadLastPoster", fields: [lastPostBy], references: [id])

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([isPinned, createdAt])
  @@index([createdAt])
}

model ForumPost {
  id               String               @id @default(uuid())
  threadId         String
  authorId         String
  content          String
  status           String               @default("ACTIVE")
  isEdited         Boolean              @default(false)
  editedAt         DateTime?
  isAnonymous      Boolean              @default(false)
  acknowledgeCount Int                  @default(0)
  hasCrisisSignal  Boolean              @default(false)
  isFirstResponder Boolean              @default(false)
  postTag          String?
  heldForReview    Boolean              @default(false)
  reviewReason     String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  author           User                 @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  thread           ForumThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  acknowledgments  PostAcknowledgment[]
  reports          ForumReport[]
  elderFlags       ElderFlag[]
  tips             ForumTip[]
  elderReactions   ElderReaction[]

  @@index([threadId, createdAt])
  @@index([authorId])
  @@index([status])
}

model PostAcknowledgment {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation("PostAcknowledgments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ForumBookmark {
  id        String      @id @default(uuid())
  userId    String
  threadId  String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

model ForumReport {
  id          String    @id @default(uuid())
  reporterId  String
  postId      String
  reason      String
  note        String?
  status      String    @default("PENDING")
  reviewedBy  String?
  reviewedAt  DateTime?
  action      String?
  createdAt   DateTime  @default(now())
  reporter    User      @relation("ForumReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@index([status])
  @@index([postId])
}

model ForumSubscription {
  id        String      @id @default(uuid())
  userId    String
  threadId  String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

model ElderFlag {
  id          String    @id @default(uuid())
  postId      String
  flaggedBy   String
  reason      String
  status      String    @default("PENDING")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  flagger     User      @relation("ElderFlagsCreated", fields: [flaggedBy], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("ElderFlagsReviewed", fields: [reviewedBy], references: [id])

  @@index([postId])
  @@index([status])
  @@index([flaggedBy])
}

// F9-705: Micro-tip for forum posts
model ForumTip {
  id         String    @id @default(uuid())
  postId     String
  fromUserId String
  toUserId   String
  amount     Float
  currency   String    @default("NGN")
  status     String    @default("COMPLETED")
  createdAt  DateTime  @default(now())
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromUser   User      @relation("TipsGiven", fields: [fromUserId], references: [id])
  toUser     User      @relation("TipsReceived", fields: [toUserId], references: [id])

  @@index([postId])
  @@index([fromUserId])
  @@index([toUserId])
}

// F9-803: Elder Reacts quick reactions
model ElderReaction {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  elder     User      @relation("ElderReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Vendor {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  businessName              String
  businessLicense           String?
  taxId                     String?
  status                    String    @default("PENDING")
  endorsementBy             String?
  description               String?
  verifiedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  artisanHeritageProof      String?
  culturalAuthenticityNotes String?
  rejectionReason           String?
  reviewedAt                DateTime?
  reviewedBy                String?
  yorubaProficiencyLevel    String?
  yorubaProficiencyProof    String?
  orders                    Order[]
  products                  Product[]
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Tutor {
  id             String         @id @default(uuid())
  userId         String         @unique
  businessName   String?
  teachingStyle  String?
  languages      String[]
  experience     Int?
  hourlyRate     Float
  currency       String         @default("NGN")
