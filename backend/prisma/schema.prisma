generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  phone                     String?                  @unique
  whatsappNumber            String?
  whatsappEnabled           Boolean                  @default(true)
  fcmTokens                 String[]                 @default([])
  googleId                  String?                  @unique
  name                      String
  passwordHash              String
  role                      String
  permissions               String[]                 @default([]) // D6: granular RBAC
  yorubaName                String?
  avatar                    String?
  bio                       String?
  aboutMe                   String?
  gender                    String?
  age                       Int?
  location                  String?
  timezone                  String?                  @default("UTC")
  culturalLevel             String                   @default("Omo Ilé")
  rankXP                    Int                      @default(0)
  dialectPreference         String?
  themeColor                String?
  profileVisibility         String                   @default("community")
  interests                 String[]                 @default([])
  intentTags                String[]                 @default([])
  verified                  Boolean                  @default(false)
  emailVerificationToken    String?                  @unique
  emailVerifiedAt           DateTime?
  hasOnboarded              Boolean                  @default(false)
  slug                      String?                  @unique
  adminSubRole              String? // FINANCE, MODERATOR, COMPLIANCE, SUPPORT, SUPER
  templeId                  String?
  averageRating             Float?                   @default(0.0)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  availability              Json?
  appointmentsAsBabalawo    Appointment[]            @relation("BabalawoAppointments")
  appointmentsAsClient      Appointment[]            @relation("ClientAppointments")
  babalawoClients           BabalawoClient[]         @relation("BabalawoRelationships")
  clientsAsBabalawo         BabalawoClient[]         @relation("ClientRelationships")
  babalawoReviews           BabalawoReview[]         @relation("BabalawoReviewClient")
  babalawoReviewsReceived   BabalawoReview[]         @relation("BabalawoReviewBabalawo")
  certificates              Certificate[]
  circlesApproved           Circle[]                 @relation("CircleApprover")
  circlesCreated            Circle[]                 @relation("CircleCreator")
  circlesSuggested          Circle[]                 @relation("CircleSuggester")
  circleFeedPosts           CircleFeedPost[]         @relation("CircleFeedAuthor")
  circleMemberships         CircleMember[]           @relation("CircleMembers")
  circleSuggestionsReviewed CircleSuggestion[]       @relation("CircleReviewer")
  circleSuggestions         CircleSuggestion[]       @relation("CircleSuggester")
  coursesInstructed         Course[]                 @relation("CourseInstructor")
  courseReviewsGiven        CourseReview[]           @relation("CourseReviewStudent")
  deviceTokens              DeviceToken[]            @relation("DeviceTokens")
  disputesAsComplainant     Dispute[]                @relation("DisputesAsComplainant")
  disputesAsRespondent      Dispute[]                @relation("DisputesAsRespondent")
  sharedDocuments           Document[]               @relation("SharedDocuments")
  documents                 Document[]               @relation("UploadedDocuments")
  enrollments               Enrollment[]             @relation("EnrollmentStudent")
  escrows                   Escrow[]                 @relation("EscrowUser")
  eventsCreated             Event[]                  @relation("EventCreator")
  eventRegistrations        EventRegistration[]      @relation("EventRegistrations")
  postsAuthored             ForumPost[]              @relation("PostAuthor")
  threadsAuthored           ForumThread[]            @relation("ThreadAuthor")
  threadsLastPoster         ForumThread[]            @relation("ThreadLastPoster")
  forumBookmarks            ForumBookmark[]
  forumReports              ForumReport[]            @relation("ForumReporter")
  forumSubscriptions        ForumSubscription[]
  elderFlagsCreated         ElderFlag[]              @relation("ElderFlagsCreated")
  elderFlagsReviewed        ElderFlag[]              @relation("ElderFlagsReviewed")
  tipsGiven                 ForumTip[]               @relation("TipsGiven")
  tipsReceived              ForumTip[]               @relation("TipsReceived")
  elderReactions            ElderReaction[]          @relation("ElderReactions")
  guidancePlansCreated      GuidancePlan[]           @relation("GuidancePlanBabalawo")
  guidancePlansReceived     GuidancePlan[]           @relation("GuidancePlanClient")
  guidancePlanTemplates     GuidancePlanTemplate[]   @relation("GuidancePlanTemplates")
  receivedMessages          Message[]                @relation("ReceivedMessages")
  sentMessages              Message[]                @relation("SentMessages")
  notifications             Notification[]           @relation("NotificationRecipient")
  ordersPlaced              Order[]                  @relation("OrderCustomer")
  returnRequests            ReturnRequest[]          @relation("ReturnRequestCustomer")
  payments                  Payment[]
  auditLogs                 AuditLog[]               @relation("UserAuditLogs")
  postAcknowledgments       PostAcknowledgment[]     @relation("PostAcknowledgments")
  productReviews            ProductReview[]          @relation("ReviewCustomer")
  socialLinks               SocialLink[]
  userJourney               SpiritualJourney?        @relation("SpiritualJourneyUser")
  templesFounded            Temple?                  @relation("TempleFounder")
  templeFollows             TempleFollow[]           @relation("TempleFollows")
  transactions              Transaction[]            @relation("TransactionUser")
  tutorProfile              Tutor?                   @relation("TutorUser")
  tutorSessions             TutorSession[]           @relation("TutorSessions")
  wordHistories             UserWordHistory[]        @relation("UserWordHistory")
  vendorProfile             Vendor?
  verificationApp           VerificationApplication?
  userWallet                Wallet?                  @relation("WalletUser")
  withdrawalRequests        WithdrawalRequest[]      @relation("WithdrawalUser")
  bankAccounts              BankAccount[]            @relation("BankAccountUser")
  castVotes                 AdvisoryVoteCast[]       @relation("CastVotes")
  proposedVotes             AdvisoryVote[]           @relation("ProposedVotes")
  templesJoined             Temple[]                 @relation("TempleMembers")
  subscriptions             Subscription[]           @relation("UserSubscriptions")
  profileViewsGiven         ProfileView[]            @relation("ProfileViewGiver")
  profileViewsReceived      ProfileView[]            @relation("ProfileViewReceiver")
  referralsMade             Referral[]               @relation("ReferralsMade")
  referralReceived          Referral?                @relation("ReferralReceived")
  reviewFlagsMade           ReviewFlag[]             @relation("ReviewFlagger")
  serviceOfferings          ServiceOffering[]        @relation("ServiceOfferingBabalawo")
  userReportsFiled          UserReport[]             @relation("UserReportReporter")
  userReportsReceived       UserReport[]             @relation("UserReportReported")
  userReportsResolved       UserReport[]             @relation("UserReportResolver")
  circleFeedLikes           CircleFeedLike[]         @relation("CircleFeedLikeUser")
  circleFeedComments        CircleFeedComment[]      @relation("CircleFeedCommentAuthor")

  // Subscription / billing fields
  subscriptionStatus String    @default("FREE") // FREE | DEVOTED | EXPIRED
  subscriptionEnd    DateTime?
  referralCode       String?   @unique

  // F9-702: Forum digest email opt-in
  forumDigestOptIn Boolean @default(true)

  // F9-703: Community Builder badge
  isCommunityBuilder Boolean @default(false)

  // F9-802: Participation streak
  contributionStreak   Int       @default(0)
  lastContributionDate DateTime?
  longestStreak        Int       @default(0)

  // F9-901: Practitioner Trust Score
  // 0-100 point scale (computed by UsersService's trust-score recalculation:
  // +30 verified, +20 consultation reviews, +15 forum posts, +10 temple member,
  // -20 active dispute, floored at 0) -- NOT 0.0-1.0. See getTrustScoreTier's
  // 75/50/30 thresholds and TrustScoreOverrideDto's @Min(0) @Max(100).
  trustScore                Float     @default(0)
  trustScoreOverride        Float?
  trustScoreOverrideReason  String?
  trustScoreOverrideBy      String?
  trustScoreOverrideAt      DateTime?
  passedCulturalOrientation Boolean   @default(false)
  culturalQuizFailCount     Int       @default(0)
  // F9-10: Inactive Practitioner Re-engagement
  isOnLeave                 Boolean   @default(false)
  isDeactivated             Boolean   @default(false)

  // ADM-003: Suspension & Ban
  suspendedUntil DateTime?
  bannedAt       DateTime?
  banReason      String?
  warnedAt       DateTime?
  warnCount      Int       @default(0)

  // ADM-007: Featured Practitioners
  isFeatured     Boolean   @default(false)
  featuredOrder  Int?
  featuredExpiry DateTime?

  // Reverse relations for new admin models
  announcements            Announcement[]          @relation("AnnouncementCreator")
  complaintsAsClient       PractitionerComplaint[] @relation("ClientComplaint")
  complaintsAsPractitioner PractitionerComplaint[] @relation("PractitionerComplaint")
  resolvedComplaints       PractitionerComplaint[] @relation("ResolverComplaint")
  refundRequestsMade       RefundRequest[]         @relation("RefundRequester")
  refundRequestsProcessed  RefundRequest[]         @relation("RefundProcessor")
  oralHistoryEntries       OralHistoryEntry[]      @relation("OralHistoryCreator")
  sacredCalendarEvents     SacredCalendarEvent[]   @relation("SacredCalendarCreator")

  // EXP-020: Personal Awo relationship
  personalAwoId      String?
  personalAwo        User?   @relation("PersonalAwoClients", fields: [personalAwoId], references: [id])
  personalAwoClients User[]  @relation("PersonalAwoClients")

  // EXP-024: Consultation Notes relations
  babalawoNotes ConsultationNote[] @relation("BabalawoNotes")
  clientNotes   ConsultationNote[] @relation("ClientNotes")

  // EXP-023: Client Session Notes
  clientSessionNotes ClientSessionNote[] @relation("ClientSessionNotes")

  // EXP-026: Notification Preferences
  userNotificationPreferences NotificationPreferences? @relation("UserNotificationPreferences")
  notificationPreferencesId   String?                  @unique

  onboardingEmails OnboardingEmail[] @relation("OnboardingEmailUser")

  // Additional relations for other models
  userBadges       UserBadge[]       @relation("UserBadges")
  badgeAwarder     UserBadge[]       @relation("BadgeAwarder")
  flagRuleCreator  ContentFlagRule[] @relation("FlagRuleCreator")
  campaignCreator  EmailCampaign[]   @relation("CampaignCreator")
  promoCodeCreator PromoCode[]       @relation("PromoCodeCreator")
  promoRedemptions PromoRedemption[] @relation("PromoRedemptions")
  userSessions     UserSession[]     @relation("UserSessions")

  // COMMUNITY_BACKLOG.md FOR-Q2: Community Member Directory -- opt-in only,
  // default false (privacy-first). Deliberately a new dedicated flag rather
  // than reinterpreting `profileVisibility` (default "community", already
  // effectively opt-out for every existing user, so redefining it here would
  // have silently opted every existing user into a new directory).
  showInDirectory            Boolean             @default(false)
  connectionRequestsSent     ConnectionRequest[] @relation("ConnectionRequester")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnectionRecipient")

  // COMMUNITY_BACKLOG.md FOR-013: ritual RSVP/intention-sharing
  ritualParticipations RitualParticipation[] @relation("RitualParticipant")

  // COMMUNITY_BACKLOG.md FOR-015: Ancestral Remembrance Wall
  memorialEntries MemorialEntry[] @relation("MemorialAuthor")

  // COMMUNITY_BACKLOG.md FOR-017: consent-based wellbeing check-ins.
  // Admin-assigned flag, same pattern as isCommunityBuilder/isFeatured --
  // not a full new role, just a marker of who has opted in to be a carer.
  isCommunityCarer           Boolean            @default(false)
  wellbeingCheckInsRequested WellbeingCheckIn[] @relation("CheckInRequester")
  wellbeingCheckInsClaimed   WellbeingCheckIn[] @relation("CheckInClaimer")

  // COMMUNITY_BACKLOG.md FOR-021: dream journal + interpretation
  dreamsAuthored    DreamEntry[] @relation("DreamAuthor")
  dreamsInterpreted DreamEntry[] @relation("DreamInterpreter")

  // SHOP_BACKLOG.md MSP-024: orders gifted to this user by someone else
  giftOrdersReceived Order[] @relation("OrderGiftRecipient")

  // COMMUNITY_BACKLOG.md FOR-018: Community Healing & Reconciliation
  healingCasesReported     HealingCase[] @relation("HealingCaseReporter")
  healingCasesAsRespondent HealingCase[] @relation("HealingCaseRespondent")
  healingCasesAsElder      HealingCase[] @relation("HealingCaseElder")

  // SHOP_BACKLOG.md MSP-019: Ritual Readiness Kits customization requests
  bundleCustomizationRequests BundleCustomizationRequest[]

  // COMMUNITY_BACKLOG.md FOR-Q3: "Ask an Elder" -- self-service opt-in
  // (the Babalawo's own choice, unlike isCommunityCarer which is
  // admin-assigned for a trust-sensitive role) to appear as available to
  // answer seeker questions in the Forum's Seeker Questions category.
  answersElderQuestions Boolean @default(false)

  // SHOP_BACKLOG.md MSP-015: products this user has community-endorsed
  productEndorsements ProductEndorsement[] @relation("ProductEndorser")

  // COMMUNITY_BACKLOG.md FOR-014: "Elder profiles with expertise areas and
  // availability". The frontend (public-profile-view.tsx) already reads
  // `user.specialization` and renders a whole "Specializations" section
  // gated on it -- that field never existed on User, only on
  // VerificationApplication (a one-time snapshot from verification, never
  // surfaced or made editable afterward), so the section always silently
  // rendered nothing. This is the real, ongoing, self-editable field the UI
  // already expected.
  specialization   String[] @default([])
  availabilityNote String?

  // COMMUNITY_BACKLOG.md FOR-014 / FOR-006: peer/elder-initiated endorsement,
  // distinct from admin-awarded UserBadge entries.
  elderEndorsementsGiven    ElderEndorsement[] @relation("ElderEndorser")
  elderEndorsementsReceived ElderEndorsement[] @relation("ElderEndorsee")

  // COMMUNITY_BACKLOG.md FOR-004: mentorship matching for new members,
  // mirroring VendorMentorship's shape but on User directly (mentor pool is
  // any user with answersElderQuestions=true, not vendor-scoped).
  communityMentorshipsAsMentor CommunityMentorship[] @relation("CommunityMentor")
  communityMentorshipsAsMentee CommunityMentorship[] @relation("CommunityMentee")

  @@map("users")
}

// COMMUNITY_BACKLOG.md FOR-014 / FOR-006: "Elder endorsement system for
// respected members (distinct from admin-awarded badges — an elder-initiated
// endorsement flow)". Any Babalawo can endorse any member; endorsements are
// computed into a badge via getUserBadges(), same pattern as every other
// badge on the platform, not a second recognition system.
model ElderEndorsement {
  id         String   @id @default(uuid())
  endorserId String
  endorseeId String
  note       String?
  createdAt  DateTime @default(now())
  endorser   User     @relation("ElderEndorser", fields: [endorserId], references: [id], onDelete: Cascade)
  endorsee   User     @relation("ElderEndorsee", fields: [endorseeId], references: [id], onDelete: Cascade)

  @@unique([endorserId, endorseeId])
  @@index([endorseeId])
}

// COMMUNITY_BACKLOG.md FOR-018: a restorative, elder-mediated conflict/harm
// case -- deliberately separate from PractitionerComplaint (admin-adjudicated,
// client-vs-practitioner formal complaints with NO_SHOW/FRAUD/etc reasons) and
// from ElderFlag/ElderReaction (content-accuracy flags on forum posts). This
// is for interpersonal community conflicts routed to an elder for restorative
// mediation, not punitive review. Never public -- visible only to the
// reporter, the named respondent (if any), the assigned elder, and admins.
model HealingCase {
  id              String    @id @default(uuid())
  reporterId      String
  respondentId    String?
  category        String // INTERPERSONAL_CONFLICT | SPIRITUAL_HARM_CONCERN | COMMUNITY_TENSION | OTHER
  description     String
  status          String    @default("OPEN") // OPEN | IN_MEDIATION | RESOLVED | CLOSED
  assignedElderId String?
  assignedAt      DateTime?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reporter        User      @relation("HealingCaseReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  respondent      User?     @relation("HealingCaseRespondent", fields: [respondentId], references: [id])
  assignedElder   User?     @relation("HealingCaseElder", fields: [assignedElderId], references: [id])

  @@index([reporterId])
  @@index([respondentId])
  @@index([status])
}

// COMMUNITY_BACKLOG.md FOR-021: private-by-default dream journal entry.
// A user can optionally share it publicly (community dream-pattern feed)
// and/or flag it for a Babalawo's interpretation -- two independent choices,
// not one "publish" toggle, since sharing publicly and wanting a
// practitioner's reading are different kinds of consent.
model DreamEntry {
  id                      String    @id @default(uuid())
  authorId                String
  content                 String
  isPublic                Boolean   @default(false)
  interpretationRequested Boolean   @default(false)
  interpretation          String?
  interpretedById         String?
  interpretedAt           DateTime?
  createdAt               DateTime  @default(now())
  deletedAt               DateTime?
  author                  User      @relation("DreamAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  interpretedBy           User?     @relation("DreamInterpreter", fields: [interpretedById], references: [id])

  @@index([authorId])
  @@index([isPublic])
  @@index([interpretationRequested])
  @@index([deletedAt])
}

model WellbeingCheckIn {
  id          String    @id @default(uuid())
  requesterId String
  message     String?
  status      String    @default("OPEN") // OPEN | CLAIMED | RESOLVED
  claimedById String?
  claimedAt   DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  requester   User      @relation("CheckInRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  claimedBy   User?     @relation("CheckInClaimer", fields: [claimedById], references: [id])

  @@index([status])
  @@index([requesterId])
}

// COMMUNITY_BACKLOG.md FOR-015: a lightweight community memorial entry --
// deliberately its own small model rather than a CircleFeedPost variant, so
// it works platform-wide and isn't tied to any one circle's lifecycle.
model MemorialEntry {
  id           String    @id @default(uuid())
  authorId     String
  name         String
  relationship String?
  message      String
  isPublic     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  // ProBacklog-v1.md item #3: grief/remembrance content someone wrote about
  // a lost loved one is exactly the kind of user-generated content a hard
  // delete has no business permanently destroying with no recovery path.
  deletedAt    DateTime?
  author       User      @relation("MemorialAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([isPublic])
  @@index([deletedAt])
}

// COMMUNITY_BACKLOG.md FOR-Q2: a member-to-member connection request, shown
// in the directory. Deliberately its own small model rather than reusing
// Referral/BabalawoClient -- neither represents a symmetric peer-to-peer
// social connection between two ordinary community members.
model ConnectionRequest {
  id          String    @id @default(uuid())
  fromUserId  String
  toUserId    String
  message     String?
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  fromUser    User      @relation("ConnectionRequester", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User      @relation("ConnectionRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

model NotificationPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailBooking        Boolean  @default(true)
  emailReminder       Boolean  @default(true)
  emailDigest         Boolean  @default(false)
  emailPlan           Boolean  @default(true)
  emailMessages       Boolean  @default(true)
  emailMarketing      Boolean  @default(false)
  pushReminder        Boolean  @default(true)
  pushMessages        Boolean  @default(true)
  pushFollowup        Boolean  @default(true)
  pushForum           Boolean  @default(false)
  pushCircles         Boolean  @default(false)
  // VENDOR_BACKLOG.md VND-004: "Vendor can toggle each notification type
  // on/off... choose push only / email only / both." Dispute and withdrawal
  // notifications are deliberately NOT gated by any preference here (due
  // process / already-in-flight money shouldn't be silenceable).
  emailOrder          Boolean  @default(true)
  pushOrder           Boolean  @default(true)
  emailReviewReceived Boolean  @default(true)
  pushReviewReceived  Boolean  @default(false)
  emailLowStock       Boolean  @default(true)
  pushLowStock        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialLink {
  id       String @id @default(uuid())
  userId   String
  platform String
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  title     String
  issuer    String
  date      String
  tier      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationApplication {
  id                 String                @id @default(uuid())
  userId             String                @unique
  lineage            String
  mentorEndorsements String[]
  yearsOfService     Int
  documentation      String[]
  specialization     String[]
  languages          String[]
  currentStage       String                @default("APPLICATION")
  tier               String?
  submittedAt        DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  approvedAt         DateTime?
  approvedById       String?
  rejectedAt         DateTime?
  rejectedById       String?
  rejectionReason    String?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history            VerificationHistory[]

  @@index([userId])
  @@index([currentStage])
}

model VerificationHistory {
  id            String                  @id @default(uuid())
  applicationId String
  stage         String
  status        String
  reviewerId    String?
  notes         String?
  timestamp     BigInt
  application   VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model BabalawoClient {
  id                      String    @id @default(uuid())
  babalawoId              String
  clientId                String
  status                  String    @default("ACTIVE")
  notes                   String?
  assignedAt              DateTime  @default(now())
  changedAt               DateTime?
  covenantAgreed          Boolean   @default(false)
  covenantText            String?
  durationMonths          Int?
  endDate                 DateTime?
  exclusivityAcknowledged Boolean   @default(false)
  expiredAt               DateTime?
  gracePeriodEnd          DateTime?
  gracePeriodStart        DateTime?
  inGracePeriod           Boolean   @default(false)
  relationshipType        String    @default("ONE_OFF")
  renewalPromptSentAt     DateTime?
  renewalPrompted         Boolean   @default(false)
  startDate               DateTime?
  babalawo                User      @relation("BabalawoRelationships", fields: [babalawoId], references: [id], onDelete: Cascade)
  client                  User      @relation("ClientRelationships", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([babalawoId, clientId])
  @@index([babalawoId])
  @@index([clientId])
  @@index([status])
  @@index([relationshipType])
  @@index([endDate])
  @@index([inGracePeriod])
}

model Message {
  id             String    @id @default(uuid())
  senderId       String
  receiverId     String
  content        String
  encrypted      Boolean   @default(true)
  read           Boolean   @default(false)
  attachments    Json?
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  autoDeleteAt   DateTime?
  autoDeleteDays Int?
  confidential   Boolean   @default(false)
  deletedAt      DateTime?
  privacyLevel   String    @default("PRIVATE")
  receiver       User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([createdAt])
  @@index([autoDeleteAt])
  @@index([confidential])
  @@index([privacyLevel])
}

model Document {
  id               String    @id @default(uuid())
  uploadedBy       String
  sharedWith       String
  type             String
  filename         String
  originalFilename String
  size             Int
  mimeType         String
  s3Key            String
  signedUrl        String?
  urlExpiresAt     DateTime?
  description      String?
  scanned          Boolean   @default(false)
  scanMethod       String?
  scanTimestamp    DateTime?
  threatDetected   Boolean?
  threatName       String?
  encrypted        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime? // P0-03: soft delete — Document had no existing
  // state field to reuse (unlike ForumThread/Circle's
  // `status`), so this is a real additive column.
  sharer           User      @relation("SharedDocuments", fields: [sharedWith], references: [id], onDelete: Cascade)
  uploader         User      @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy, sharedWith])
  @@index([s3Key])
  @@index([deletedAt])
}

model Appointment {
  id           String        @id @default(uuid())
  babalawoId   String
  clientId     String
  date         String
  time         String
  timezone     String        @default("Africa/Lagos")
  // P2-03: UTC instant derived from date+time+timezone at write time. date/time/timezone
  // are kept (read-only going forward) for one release as a rollback safety net; all new
  // booking/availability/display logic reads scheduledAt instead. Nullable rather than
  // required because a handful of pre-migration rows with malformed date/time strings
  // couldn't be safely backfilled — see migration 20260704000001_add_scheduled_at.
  scheduledAt  DateTime?     @db.Timestamptz
  duration     Int           @default(60)
  status       String        @default("UPCOMING")
  price        Decimal?      @db.Decimal(14, 2)
  notes        String?
  cancelledAt  DateTime?
  cancelledBy  String?
  isPriority   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  recordingUrl String?
  videoRoomId  String?
  videoToken   String?
  topic        String?
  babalawo     User          @relation("BabalawoAppointments", fields: [babalawoId], references: [id], onDelete: Cascade)
  client       User          @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  guidancePlan GuidancePlan?

  // EXP-023: Client Session Notes
