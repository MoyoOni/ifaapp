model Vendor {
  id                        String          @id @default(uuid())
  userId                    String          @unique
  businessName              String
  businessLicense           String?
  taxId                     String?
  // VENDOR_BACKLOG.md VND-003: self-reported by the vendor, not
  // admin-verified -- same trust model as taxId above. Used to show the VAT
  // flag on tax summaries; not enforced or validated against a real VAT registry.
  vatRegistered             Boolean         @default(false)
  vatNumber                 String?
  status                    String          @default("PENDING")
  endorsementBy             String?
  description               String?
  verifiedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  artisanHeritageProof      String?
  culturalAuthenticityNotes String?
  rejectionReason           String?
  reviewedAt                DateTime?
  reviewedBy                String?
  yorubaProficiencyLevel    String?
  yorubaProficiencyProof    String?
  // SHOP_BACKLOG.md MSP-016: apprenticeship tier, distinct from `status`
  // (which only gates PENDING/APPROVED/SUSPENDED/REJECTED). Advanced by
  // admin/elder action only -- never automatic -- per this doc's own
  // "no algorithmic black-box decisions" principle.
  apprenticeshipTier        String          @default("APPRENTICE") // APPRENTICE | RECOGNIZED_ARTISAN | MASTER_PRACTITIONER | ELDER_APPROVED
  tierUpdatedAt             DateTime?
  tierUpdatedBy             String?
  // VENDOR_BACKLOG.md VND-026: distinct from apprenticeshipTier above --
  // that one is spiritual/cultural, admin/elder-advanced only, and never
  // automatic (per its own comment). This one is auto-computed from real
  // commercial metrics (sales, rating, return rate, account age) by
  // VendorPerformanceTierService, recalculated nightly. NEW_VENDOR |
  // ESTABLISHED | TRUSTED_VENDOR | SACRED_ARTISAN.
  performanceTier           String          @default("NEW_VENDOR")
  performanceTierUpdatedAt  DateTime?
  // VENDOR_BACKLOG.md VND-017: distinct from both tier fields above --
  // apprenticeshipTier is the vendor's own spiritual/cultural standing,
  // performanceTier is auto-computed from commercial metrics. This one is a
  // trust marker about a vendor's PRODUCTS' authenticity/sourcing, reviewed
  // per-application (see VendorCertificationApplication below), and is what
  // actually renders as a badge on product cards/detail pages and drives the
  // marketplace "Elder Endorsed" filter. COMMUNITY_LISTED (default, no
  // vetting, self-declared) | COMMUNITY_VERIFIED | ELDER_ENDORSED.
  culturalCertificationTier String          @default("COMMUNITY_LISTED")
  // VENDOR_BACKLOG.md VND-016: storefront identity. `description` doubles as
  // the vendor's bio/about text (no separate field -- the backlog item says
  // "extended from current description", not a second one). Featured
  // products are capped at 3 in the service layer, not the schema.
  bannerImageUrl            String?
  featuredProductIds        String[]        @default([])
  // VENDOR_BACKLOG.md VND-023: custom storefront URL, e.g. iluase.com/vendors/oshun-beads-by-adunola.
  // Optional -- a vendor without one is still reachable via their storefront
  // route using their userId, same as before this item.
  slug                      String?         @unique
  orders                    Order[]
  products                  Product[]
  bundles                   ProductBundle[]
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // VENDOR_BACKLOG.md VND-019 / SHOP_BACKLOG.md MSP-016/MSP-018
  mentorshipsAsMentor VendorMentorship[]     @relation("VendorMentor")
  mentorshipsAsMentee VendorMentorship[]     @relation("VendorMentee")
  spiritualLeaves     VendorSpiritualLeave[]

  // SHOP_BACKLOG.md MSP-005
  partnershipsCreated VendorPartnership[]

  // SHOP_BACKLOG.md MSP-008
  eventFeatureRequests EventProductFeature[]

  // VENDOR_BACKLOG.md VND-011
  shippingZones ShippingZone[]

  // VENDOR_BACKLOG.md VND-010
  returnRequests ReturnRequest[]

  // VENDOR_BACKLOG.md VND-020
  promotions VendorPromotion[]

  // VENDOR_BACKLOG.md VND-017
  certificationApplications VendorCertificationApplication[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// VENDOR_BACKLOG.md VND-017: application/review history for a vendor
// requesting a higher cultural-certification tier. One row per application --
// a declined vendor can reapply, creating a new row rather than overwriting
// the old one, so the history stays intact.
model VendorCertificationApplication {
  id            String    @id @default(uuid())
  vendorId      String
  requestedTier String // COMMUNITY_VERIFIED | ELDER_ENDORSED
  // Provenance statement, sourcing details, artisan lineage -- vendor's own
  // written submission. Text, not a file upload: matches the existing
  // Vendor.artisanHeritageProof precedent (also just a String) rather than
  // introducing a new S3 upload flow for this one field.
  documentation String
  status        String    @default("PENDING") // PENDING | APPROVED | DECLINED
  declineReason String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

// VENDOR_BACKLOG.md VND-011: vendor-level shipping configuration. Scoped to
// the vendor rather than per-product for this pass -- a vendor sets up
// their zones once and every one of their products uses the same zone
// structure at checkout. "By region" from the backlog's rate-type list is
// achieved by having multiple zones (e.g. "Nigeria" vs "International"),
// not a fourth rate type.
model ShippingZone {
  id                          String   @id @default(uuid())
  vendorId                    String
  name                        String
  // ISO country names/codes this zone covers. Matched case-insensitively
  // against the order's shippingCountry at checkout.
  countries                   String[]
  rateType                    String   @default("FLAT") // FREE | FLAT | WEIGHT_BASED
  flatRate                    Float    @default(0)
  perKgRate                   Float    @default(0)
  processingTime              String   @default("3-5 business days")
  // e.g. 10 = 10% off the computed shipping cost when the order has 2+ items
  combinedShippingDiscountPct Float    @default(0)
  // Fallback zone used when the customer's country doesn't match any other
  // zone's `countries` list. A vendor should have at most one of these --
  // enforced in the service layer, not a DB constraint (a vendor may
  // temporarily have zero or, mid-edit, briefly more than one).
  isDefault                   Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  vendor                      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// VENDOR_BACKLOG.md VND-019: new vendors matched with an experienced vendor
// for a 30-day welcome period. One ACTIVE mentorship per mentee at a time,
// enforced in application logic (vendor-community.service.ts) rather than a
// DB constraint, since a vendor may go through more than one mentorship
// over their lifetime (e.g. after COMPLETED, they could request another).
model VendorMentorship {
  id        String   @id @default(uuid())
  mentorId  String
  menteeId  String
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED
  startedAt DateTime @default(now())
  endsAt    DateTime
  mentor    Vendor   @relation("VendorMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    Vendor   @relation("VendorMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

// COMMUNITY_BACKLOG.md FOR-004: "Mentorship matching for new members" --
// same shape as VendorMentorship (VENDOR_BACKLOG.md VND-019), but the mentor
// pool is any user with answersElderQuestions=true (COMMUNITY_BACKLOG.md
// FOR-Q3's "Ask an Elder" opt-in) rather than tenured vendors, and mentees
// are any authenticated user, not vendor-scoped.
model CommunityMentorship {
  id        String   @id @default(uuid())
  mentorId  String
  menteeId  String
  status    String   @default("ACTIVE") // ACTIVE | COMPLETED
  startedAt DateTime @default(now())
  endsAt    DateTime
  mentor    User     @relation("CommunityMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User     @relation("CommunityMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([status])
}

// SHOP_BACKLOG.md MSP-018: vendor requests time away from order fulfilment
// expectations for a ceremony/observance, without it counting against
// fulfilment-rate metrics elsewhere on the platform.
model VendorSpiritualLeave {
  id        String   @id @default(uuid())
  vendorId  String
  reason    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// SHOP_BACKLOG.md MSP-005: a declared, self-service vendor group -- not a
// marketplace listing, so it needs no admin review (unlike ProductBundle).
// memberVendorIds is a plain array (same pattern as OralHistoryEntry's
// relatedProductIds/tags) rather than a join table, since membership here
// carries no extra per-member data yet.
// "Shared inventory for large-scale ceremonies" and "joint offerings" are
// deliberately NOT modeled here -- those genuinely need VND-025 (Wholesale &
// B2B Sales, unbuilt); a partnership instead points members at ProductBundle
// (MSP-002, cross-vendor already) for anything resembling a joint listing.
// "Collaborative cultural education content creation" reuses OralHistoryEntry
// tags (MSP-022's collection-browsing) rather than a new content model --
// members tag their submissions with the partnership's auto-generated tag.
model VendorPartnership {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  createdBy            String
  memberVendorIds      String[]             @default([])
  plannedEventId       String?
  // Auto-created in the Vendor Circle forum the moment the partnership is
  // formed -- reuses Forum (VND-019) rather than a parallel messaging system.
  coordinationThreadId String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  creator              Vendor               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  plannedEvent         SacredCalendarEvent? @relation(fields: [plannedEventId], references: [id])

  @@index([createdBy])
  @@index([plannedEventId])
}

model Tutor {
  id             String         @id @default(uuid())
  userId         String         @unique
  businessName   String?
  teachingStyle  String?
  languages      String[]
  experience     Int?
  hourlyRate     Float
  currency       String         @default("NGN")
  specialization String[]
  availability   String?
  status         String         @default("PENDING")
  endorsementBy  String?
  description    String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
