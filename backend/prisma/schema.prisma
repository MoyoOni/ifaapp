model Product {
  id                        String                   @id @default(uuid())
  vendorId                  String
  name                      String
  category                  String
  subcategory               String?
  type                      String                   @default("PHYSICAL")
  description               String
  longDescription           String?
  price                     Decimal                  @db.Decimal(14, 2)
  currency                  String                   @default("NGN")
  stock                     Int?
  images                    String[]
  provenance                String?
  usageProtocol             String?
  // VENDOR_BACKLOG.md VND-011: kg, used by WEIGHT_BASED shipping zones.
  // Nullable -- a product with no weight set falls back to a 1kg default
  // during shipping calculation rather than crashing the estimate.
  weight                    Float?
  requiresInitiation        Boolean                  @default(false)
  status                    String                   @default("ACTIVE")
  approvedBy                String?
  verifiedTier              String                   @default("COMMUNITY_LISTED")
  taxCompliant              Boolean                  @default(false)
  isFeatured                Boolean                  @default(false)
  featuredUntil             DateTime?
  // VENDOR_BACKLOG.md VND-018: all optional -- a vendor selling generic goods
  // isn't required to fill these in, only vendors with an authentic Yoruba
  // naming/context to add one.
  yorubaName                String?
  yorubaDescription         String?
  pronunciationGuide        String?
  traditionalUseContext     String?
  regionOfOrigin            String?
  // VENDOR_BACKLOG.md VND-023
  seoTitle                  String?
  seoDescription            String?
  tags                      String[]                 @default([])
  // VENDOR_BACKLOG.md VND-024: exactly one of these two is set for a
  // type=DIGITAL product with delivery configured -- an S3-hosted upload
  // (digitalFileKey, never exposed directly; downloads always go through a
  // freshly-minted signed URL) or a vendor-supplied external link (Google
  // Drive/Dropbox/etc, per the backlog's explicit "or link to externally
  // hosted file" allowance -- no upload pipeline needed for that path).
  digitalFileKey            String?
  digitalFileUrl            String?
  digitalFileName           String?
  digitalFileSizeBytes      Int?
  digitalDownloads          DigitalProductDownload[]
  // VENDOR_BACKLOG.md VND-025: wholesalePrice is deliberately never returned
  // by the public product endpoint (findProductById strips it before
  // responding) -- only the gated getWholesalePrice() lookup (BABALAWO/
  // ADMIN only) and createOrder's own pricing logic ever read it directly.
  wholesaleEnabled          Boolean                  @default(false)
  wholesaleMinQuantity      Int?
  wholesalePrice            Decimal?                 @db.Decimal(14, 2)
  // VENDOR_BACKLOG.md VND-008: "scheduled listing" is expressed as
  // status=DRAFT + a future scheduledAt, not a separate enum value --
  // ScheduledListingActivationService flips it to ACTIVE once scheduledAt
  // passes. showComingSoon opts a still-draft, still-scheduled product into
  // being visible (as "Coming Soon") in the public marketplace listing
  // instead of fully hidden like an ordinary draft.
  scheduledAt               DateTime?
  showComingSoon            Boolean                  @default(false)
  // "Stock treated as pre-order slots" per the backlog -- reuses the
  // existing `stock` field rather than adding a second counter.
  isPreOrder                Boolean                  @default(false)
  expectedDeliveryDate      DateTime?
  // VENDOR_BACKLOG.md VND-005
  lowStockThreshold         Int                      @default(5)
  // "Made to Order" -- infinite stock is already how a null `stock` behaves
  // everywhere stock is checked (createOrder, etc.), so this is a clearer,
  // explicit label over that existing behavior, not a second stock-tracking
  // mode. The vendor form sends `stock: null` alongside this flag.
  isMadeToOrder             Boolean                  @default(false)
  madeToOrderProcessingTime String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  orders                    OrderItem[]
  vendor                    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviews                   ProductReview[]
  bundleItems               ProductBundleItem[]
  endorsements              ProductEndorsement[]
  eventFeatureRequests      EventProductFeature[]
  stockChangeLogs           StockChangeLog[]

  // SHOP_BACKLOG.md MSP-015: "flagging with gentle education" -- same
  // heldForReview/reviewReason/reviewedBy/reviewedAt shape ADM-018 uses for
  // ForumPost, extended to Product. Unlike the ForumPost version (which
  // exists but is never actually set by any community action -- discovered
  // while building this), this one is wired end-to-end from the start.
  heldForReview Boolean   @default(false)
  reviewReason  String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // VENDOR_BACKLOG.md VND-007: up to 3 variant "axes" (e.g. ["Colour",
  // "Size"]) -- the actual combinations (Yellow/Medium, Yellow/Large, ...)
  // live as individual ProductVariant rows, one per combination, not one
  // row per axis. A product with an empty array has no variants and is
  // ordered exactly as before this item.
  variantAttributeNames String[]         @default([])
  variants              ProductVariant[]

  @@index([vendorId])
  @@index([category])
  @@index([subcategory])
  @@index([status])
  @@index([verifiedTier])
  @@index([vendorId, status])
  @@index([category, status])
  @@index([category, subcategory])
  @@index([heldForReview])
}

// VENDOR_BACKLOG.md VND-007: one row per specific variant combination (e.g.
// Colour=Yellow + Size=Medium), not one row per axis. `attributes` is a
// small fixed-shape JSON map ({ [axisName]: value }) rather than a separate
// join table -- there are at most 3 axes (enforced in the service layer),
// so a normalized attribute table would be pure overhead for no real
// querying benefit here (variants are always fetched per-product, never
// filtered by attribute value across products).
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  attributes    Json
  sku           String?
  // Both null means "use the parent product's price/stock unmodified" --
  // most vendors won't want a price difference between colours, and stock
  // is optional the same way Product.stock already is (VND-005's
  // isMadeToOrder / infinite-stock convention carries over here).
  priceOverride Decimal? @db.Decimal(14, 2)
  stock         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  OrderItem[]

  @@index([productId])
}

// VENDOR_BACKLOG.md VND-005: "log of stock changes: who changed it, when,
// from what to what -- useful for reconciling physical stock against
// platform records." changedBy is null for order-driven (ORDER_SALE)
// changes -- there's no human "who" for a sale, the customer isn't a stock
// manager and attributing it to them would be misleading.
model StockChangeLog {
  id            String   @id @default(uuid())
  productId     String
  previousStock Int?
  newStock      Int?
  source        String // VENDOR_EDIT | BULK_RESTOCK | ORDER_SALE | CSV_IMPORT
  changedBy     String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

// SHOP_BACKLOG.md MSP-015: "Community-endorsed authenticity badge" --
// deliberately its own small join model rather than forced into UserBadge
// (which is user-centric: {userId, badgeType}), since this is a per-product
// signal from many different endorsers, not a badge awarded to one user.
// Follows the same computed-on-read pattern as getUserBadges() -- the badge
// itself isn't stored, it's derived from endorsement count at read time.
model ProductEndorsement {
  id        String   @id @default(uuid())
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation("ProductEndorser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// SHOP_BACKLOG.md MSP-002: a curated cross-vendor bundle. No price/discount
// field here on purpose -- price and availability are always computed from
// the live component products (see marketplace.service.ts), so a bundle can
// never go stale relative to a vendor updating their own product's price or
// stock. Revenue is naturally split because checkout still creates one Order
// per vendor represented in the bundle -- no new payment-splitting logic
// needed, "bundle" is purely a curation/discovery layer on top of Product.
model ProductBundle {
  id              String              @id @default(uuid())
  name            String
  description     String?
  status          String              @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  creator         Vendor              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  items           ProductBundleItem[]

  // SHOP_BACKLOG.md MSP-019: Ritual Readiness Kits. ritualGuide extends the
  // same idea as Product.usageProtocol but at the kit level (a kit combines
  // several products into one ceremony, so its guide is bigger than any one
  // item's). guideSourceUrl mirrors OralHistoryEntry.sourceUrl -- an external
  // audio/video link, not a new upload/media pipeline. Both are set by the
  // bundle's own vendor after approval (PATCH .../guide), never gated by
  // admin re-review since they're additive guidance, not a pricing/item change.
  ritualGuide           String?
  guideSourceUrl        String?
  // Auto-created when an admin approves the bundle (reviewBundle in
  // AdminMarketplaceService) -- reuses Forum (live) rather than a parallel
  // comment system, per this item's own acceptance criteria.
  supportThreadId       String?                      @unique
  reflectionThreadId    String?                      @unique
  customizationRequests BundleCustomizationRequest[]

  @@index([createdBy])
  @@index([status])
}

// SHOP_BACKLOG.md MSP-019: "Kit customization ('I have X, I need Y')" --
// a lightweight request/response loop, not a live chat (Messaging is paused
// platform-wide, see CLAUDE.md), same Notification-based pattern used
// throughout this session for vendor<->buyer coordination without live chat.
model BundleCustomizationRequest {
  id             String        @id @default(uuid())
  bundleId       String
  requesterId    String
  haveItems      String
  needItems      String
  status         String        @default("OPEN") // OPEN | RESPONDED
  vendorResponse String?
  createdAt      DateTime      @default(now())
  respondedAt    DateTime?
  bundle         ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([requesterId])
}

model ProductBundleItem {
  id        String        @id @default(uuid())
  bundleId  String
  productId String
  quantity  Int           @default(1)
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
}

model Order {
  id                  String      @id @default(uuid())
  customerId          String
  vendorId            String
  status              String      @default("PENDING")
  totalAmount         Decimal     @db.Decimal(14, 2)
  currency            String      @default("NGN")
  taxAmount           Decimal?    @db.Decimal(14, 2)
  shippingCost        Decimal?    @db.Decimal(14, 2)
  shippingAddress     String?
  // VENDOR_BACKLOG.md VND-011: needed to match the order against a vendor's
  // ShippingZone.countries at checkout. shippingAddress is free text, not
  // structured, so this is captured as its own field rather than parsed out.
  shippingCountry     String?
  // V8-304: persisted so order history/receipts can honestly show the
  // Devoted free-delivery benefit actually applied, instead of only being
  // visible transiently in the checkout response (shippingCost alone can't
  // tell "Devoted waived it" apart from "this vendor's zone is free anyway").
  devotedFreeDelivery Boolean     @default(false)
  paymentMethod       String?
  paymentId           String?
  paidAt              DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  refundAmount        Decimal?    @db.Decimal(14, 2)
  refundReason        String?
  notes               String?
  // VENDOR_BACKLOG.md VND-009: distinct from `notes` above, which is the
  // customer's own note captured at checkout -- this is vendor-only and
  // never returned to the customer-facing order views.
  vendorNotes         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?
  // VENDOR_BACKLOG.md VND-022: set once a "please review" request has gone
  // out for this order, whether via the weekly auto-nudge or a vendor's
  // manual trigger -- both paths check this before sending, so the two
  // don't double-notify each other and each order only ever gets one ask.
  reviewRequestSentAt DateTime?
  customer            User        @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  vendor              Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items               OrderItem[]

  // SHOP_BACKLOG.md MSP-024: gifting, using the existing Order/checkout
  // flow rather than a new payment path. isGift + giftRecipientId cover
  // "gift this item"; dedicatedTo alone (no recipient) covers "dedicate
  // this purchase to my ancestors" -- two independent, optional uses.
  isGift          Boolean @default(false)
  giftRecipientId String?
  giftMessage     String?
  dedicatedTo     String?
  giftRecipient   User?   @relation("OrderGiftRecipient", fields: [giftRecipientId], references: [id])

  // VENDOR_BACKLOG.md VND-010: at most one return request per order --
  // deliberately not a re-openable/repeatable flow within this pass.
  returnRequest ReturnRequest?

  // VENDOR_BACKLOG.md VND-024
  digitalDownloads DigitalProductDownload[]

  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([paidAt])
  @@index([giftRecipientId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // VENDOR_BACKLOG.md VND-007: which specific variant combination was
  // purchased, if the product has variants. SetNull (not Cascade) on
  // variant deletion -- an OrderItem is order history and must survive a
  // later variant cleanup, even if it loses the variant detail.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// VENDOR_BACKLOG.md VND-010: one return request per order (Order.returnRequest
// is @unique on orderId). status: REQUESTED | ACCEPTED | REJECTED |
// PARTIAL_REFUND_OFFERED | REFUNDED | ESCALATED. reasonCategory is a fixed
// rule-based set (not freeform-text clustering) so "most common return
// reasons" analytics are an honest count, not a fabricated NLP summary.
model ReturnRequest {
  id                  String    @id @default(uuid())
  orderId             String    @unique
  customerId          String
  vendorId            String
  reasonCategory      String // NOT_AS_DESCRIBED | DAMAGED_DEFECTIVE | WRONG_ITEM | QUALITY_ISSUE | CHANGED_MIND | OTHER
  reason              String
  photos              String[]  @default([])
  status              String    @default("REQUESTED")
  vendorResponse      String?
  offeredRefundAmount Decimal?  @db.Decimal(14, 2)
  returnAddress       String?
  respondedAt         DateTime?
  customerConfirmedAt DateTime?
  refundedAt          DateTime?
  disputeId           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User   @relation("ReturnRequestCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([customerId])
  @@index([status])
}

// VENDOR_BACKLOG.md VND-020: one flexible model for all 5 promotion types
// rather than 5 separate tables -- same "typed discriminator + nullable
// type-specific fields" pattern already used for Dispute/SacredCalendarEvent
// in this schema. Deliberately supports at most one promotion applying to
// an order (see calculateBestPromotion() in marketplace.service.ts) rather
// than a stacking-rules engine -- simpler to reason about and test, and
// avoids surprising a vendor with combined discounts they didn't design for.
//
// type-specific field usage:
//   DISCOUNT_CODE:     code, discountType, value, maxUses, eligibleProductIds
//   FLASH_SALE:        productId, discountType, value, startsAt, expiresAt
//   VOLUME_DISCOUNT:   productId (or null = vendor-wide), minQuantity, discountType, value
//   BUNDLE_DEAL:       productId + bundleProductId (both required in cart), discountType, value
//   WELCOME_DISCOUNT:  discountType, value, eligibleProductIds (auto-applied to a customer's first order with this vendor, no code needed)
model VendorPromotion {
  id                 String    @id @default(uuid())
  vendorId           String
  type               String
  name               String
  code               String?
  discountType       String    @default("PERCENTAGE") // PERCENTAGE | FIXED_AMOUNT
  value              Decimal   @db.Decimal(14, 2)
  maxUses            Int?
  usedCount          Int       @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  eligibleProductIds String[]  @default([])
  productId          String?
  minQuantity        Int?
  bundleProductId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor      Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  redemptions VendorPromotionRedemption[]

  @@unique([vendorId, code])
  @@index([vendorId])
  @@index([code])
  @@index([type])
}

model VendorPromotionRedemption {
  id          String   @id @default(uuid())
  promotionId String
  orderId     String
  customerId  String
  discountNgn Decimal  @db.Decimal(14, 2)
  redeemedAt  DateTime @default(now())

  promotion VendorPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([orderId])
}

// VENDOR_BACKLOG.md VND-024: "customer gets download link (valid 30 days,
// max 5 downloads)." One grant per (order, product) pair, not per unit --
// a digital good is not consumed by download count the way physical stock
// is, so buying 3 copies of the same PDF still grants one 5-download
// window, not fifteen. downloadCount is incremented server-side each time
// a fresh signed URL is actually issued, never client-reported.
model DigitalProductDownload {
  id            String   @id @default(uuid())
  orderId       String
  productId     String
  customerId    String
  downloadCount Int      @default(0)
  maxDownloads  Int      @default(5)
  expiresAt     DateTime
  // VENDOR_BACKLOG.md VND-010: set when a confirmed return refunds this
  // order -- getDigitalDownloadUrl() refuses to mint a fresh signed URL
  // once this is true, even if downloadCount/expiresAt would otherwise
  // still allow it.
  revoked       Boolean  @default(false)
  createdAt     DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([customerId])
  @@index([orderId])
}

model ProductReview {
  id                String    @id @default(uuid())
  productId         String
  customerId        String
  rating            Int
  title             String?
  content           String?
  acknowledgeCount  Int       @default(0)
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  flaggedCount      Int       @default(0)
  moderatedAt       DateTime?
  moderatedBy       String?
  moderationNotes   String?
  orderId           String?
  // VENDOR_BACKLOG.md VND-022: "one response per review" -- enforced in the
  // service by refusing to overwrite a non-null vendorResponse, not by a
  // second table, since a review has at most one.
  vendorResponse    String?
  vendorRespondedAt DateTime?
  customer          User      @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([orderId])
}

model BabalawoReview {
  id                    String    @id @default(uuid())
  babalawoId            String
  clientId              String
  appointmentId         String?
  rating                Int
  title                 String?
  content               String?
  accuracyRating        Int?
  communicationRating   Int?
  culturalRespectRating Int?
  acknowledgeCount      Int       @default(0)
  status                String    @default("PENDING")
  moderatedBy           String?
  moderatedAt           DateTime?
  moderationNotes       String?
  flaggedCount          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  babalawo              User      @relation("BabalawoReviewClient", fields: [babalawoId], references: [id], onDelete: Cascade)
  client                User      @relation("BabalawoReviewBabalawo", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([babalawoId, clientId])
  @@index([babalawoId])
  @@index([clientId])
  @@index([status])
  @@index([appointmentId])
}

model CourseReview {
  id                   String    @id @default(uuid())
  courseId             String
  studentId            String
  enrollmentId         String?
  rating               Int
  title                String?
  content              String?
  contentQualityRating Int?
  instructorRating     Int?
  valueRating          Int?
  acknowledgeCount     Int       @default(0)
  status               String    @default("PENDING")
  moderatedBy          String?
  moderatedAt          DateTime?
  moderationNotes      String?
  flaggedCount         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student              User      @relation("CourseReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@index([enrollmentId])
}

// One row per (reviewType, reviewId, flaggedBy) -- prevents a single account
// from repeatedly flagging the same review to force it past the
// flaggedCount >= 2 auto-flag threshold. reviewId deliberately has no FK: it
// points at whichever of ProductReview/BabalawoReview/CourseReview
// reviewType selects, and Prisma doesn't support a relation to one of
// several possible target models.
model ReviewFlag {
  id         String   @id @default(uuid())
  reviewType String
  reviewId   String
  flaggedBy  String
  createdAt  DateTime @default(now())
  flagger    User     @relation("ReviewFlagger", fields: [flaggedBy], references: [id], onDelete: Cascade)

  @@unique([reviewType, reviewId, flaggedBy])
  @@index([reviewType, reviewId])
  @@map("review_flags")
}

model Course {
  id                 String         @id @default(uuid())
  instructorId       String
  title              String
  slug               String         @unique
  description        String
  category           String
  level              String         @default("BEGINNER")
  thumbnail          String?
  duration           Int?
  price              Decimal        @db.Decimal(14, 2)
  currency           String         @default("NGN")
  status             String         @default("DRAFT")
  approvedBy         String?
  enrolledCount      Int            @default(0)
  lessonCount        Int            @default(0)
  certificateEnabled Boolean        @default(true)
  isDevoted          Boolean        @default(false) // V8: gate behind Devoted tier
  isFeatured         Boolean        @default(false)
  featuredUntil      DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  instructor         User           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  reviews            CourseReview[]
  enrollments        Enrollment[]
  lessons            Lesson[]

  @@index([instructorId])
  @@index([category])
  @@index([status])
  @@index([slug])
}

model Lesson {
  id          String             @id @default(uuid())
  courseId    String
  title       String
  order       Int
  type        String             @default("VIDEO")
  content     String?
  videoUrl    String?
  audioUrl    String?
  duration    Int?
  resources   String[]
  status      String             @default("DRAFT")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId, order])
  @@index([deletedAt])
}

model Enrollment {
  id               String             @id @default(uuid())
  courseId         String
  studentId        String
  status           String             @default("ACTIVE")
  progress         Float              @default(0)
  enrolledAt       DateTime           @default(now())
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  certificate      CourseCertificate?
  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          User               @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  LessonCompletion LessonCompletion[]

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model LessonCompletion {
  id           String     @id @default(uuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model CourseCertificate {
  id             String     @id @default(uuid())
  enrollmentId   String     @unique
  certificateUrl String
  issuedAt       DateTime   @default(now())
  deletedAt      DateTime?
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([deletedAt])
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  // ProBacklog-v1.md item #15: was Float -- repeated arithmetic over an
  // account's lifetime (deposits, escrow holds/releases, withdrawal
  // holds/refunds) could accumulate binary floating-point error. Postgres
  // NUMERIC now does exact decimal arithmetic for every `increment`/
  // `decrement` (Prisma translates those into `balance = balance + $1` at
  // the SQL level, so this fixes drift without needing to rewrite those call
  // sites). JS-side reads go through DecimalToNumberInterceptor for HTTP
  // responses, and are explicitly Number()-converted at the two in-process
  // (non-HTTP) read sites in wallet.service.ts.
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  currency     String        @default("NGN")
  locked       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  escrows      Escrow[]
  transactions Transaction[]
  user         User          @relation("WalletUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id                 String    @id @default(uuid())
  walletId           String
  userId             String
  type               String
  amount             Decimal   @db.Decimal(14, 2)
  currency           String    @default("NGN")
  status             String    @default("PENDING")
  description        String?
  reference          String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  manuallyVerified   Boolean   @default(false)
  manuallyVerifiedAt DateTime?
  manuallyVerifiedBy String?
  webhookReceived    Boolean   @default(false)
  webhookReceivedAt  DateTime?
  idempotencyKey     String?   @unique
  user               User      @relation("TransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  wallet             Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([webhookReceived])
  @@index([createdAt])
  @@index([userId, type])
  @@index([userId, status])
  @@index([walletId, createdAt])
}

// P1-01: Outbox pattern. Written inside the same $transaction as a wallet/
// payment balance change so the "notify the user" intent is never lost even
// if the actual WhatsApp/email/push send fails or the process crashes right
// after the DB commit — a separate poller (OutboxPollerService) picks up
// PENDING rows and dispatches them through a retryable BullMQ queue.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String // e.g. 'WALLET', 'PAYMENT'
  aggregateId   String // e.g. walletId or transactionId
  eventType     String // e.g. 'PAYMENT_RECEIVED', 'REFUND_PROCESSED'
  payload       Json
