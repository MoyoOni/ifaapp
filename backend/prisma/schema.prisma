// ADM-008: Practitioner Complaint Handling
model PractitionerComplaint {
  id                   String    @id @default(uuid())
  clientId             String
  practitionerId       String
  reason               String // NO_SHOW | INAPPROPRIATE | FRAUD | OTHER
  description          String
  evidence             String[]  @default([])
  status               String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  resolution           String?
  resolvedById         String?
  resolvedAt           DateTime?
  resolutionNotes      String?
  // COMMUNITY_BACKLOG.md FOR-016: "Keyword/pattern-based community flagging
  // (not ML)" -- set at filing time by scanning `description` against active
  // ContentFlagRule KEYWORD rules (the same curated, human-authored list
  // ADM-018 uses for ForumPost, previously never evaluated against anything
  // -- see complaints.service.ts). Used to sort flagged complaints first in
  // the admin queue, not to auto-act on them.
  flaggedByKeywordRule Boolean   @default(false)
  matchedKeywords      String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  client               User      @relation("ClientComplaint", fields: [clientId], references: [id], onDelete: Cascade)
  practitioner         User      @relation("PractitionerComplaint", fields: [practitionerId], references: [id], onDelete: Cascade)
  resolvedBy           User?     @relation("ResolverComplaint", fields: [resolvedById], references: [id])

  @@index([clientId])
  @@index([practitionerId])
  @@index([status])
  @@index([createdAt])
  @@index([flaggedByKeywordRule])
}

// Whole-app audit loose end: generic report against any user (CLIENT/VENDOR/
// BABALAWO), mirroring PractitionerComplaint's shape/flow above but not
// restricted to a practitioner as the target -- profile "Report" for
// non-babalawo users had no backend at all before this.
model UserReport {
  id                   String    @id @default(uuid())
  reporterId           String
  reportedUserId       String
  reason               String // HARASSMENT | SPAM | IMPERSONATION | INAPPROPRIATE | FRAUD | OTHER
  description          String
  status               String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | DISMISSED
  resolvedById         String?
  resolvedAt           DateTime?
  resolutionNotes      String?
  flaggedByKeywordRule Boolean   @default(false)
  matchedKeywords      String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reporter             User      @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser         User      @relation("UserReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy           User?     @relation("UserReportResolver", fields: [resolvedById], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([createdAt])
}

// F9-806: Àṣẹ Live audio space
model LiveSession {
  id           String   @id @default(uuid())
  title        String
  hostIds      String[]
  scheduledAt  DateTime
  platform     String
  externalUrl  String
  preThreadId  String?
  recordingUrl String?
  status       String   @default("SCHEDULED")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model OralHistoryEntry {
  id                String    @id @default(uuid())
  title             String
  category          String
  babalawoName      String?
  recordingDate     DateTime?
  tags              String[]  @default([])
  content           String
  sourceUrl         String?
  // COMMUNITY_BACKLOG.md FOR-019: marketplace connection -- Product IDs this
  // story relates to. A plain ID array rather than a join table, matching the
  // existing `tags` pattern on this same model; a story-to-item link doesn't
  // need relational integrity enforcement beyond "does this product exist".
  relatedProductIds String[]  @default([])
  publishedAt       DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  creator User @relation("OralHistoryCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([publishedAt])
}

model SacredCalendarEvent {
  id          String    @id @default(uuid())
  title       String
  yorubaName  String?
  description String
  date        DateTime
  endDate     DateTime?
  type        String    @default("FESTIVAL")
  bannerColor String?
  isActive    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator                User                  @relation("SacredCalendarCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  participations         RitualParticipation[]
  vendorPartnerships     VendorPartnership[]
  productFeatureRequests EventProductFeature[]

  // SHOP_BACKLOG.md MSP-008: "Post-ceremony/post-season community reflection
  // tied to Forum" -- auto-created (SeasonalEventReminderService) once the
  // event's date has passed, same auto-thread pattern as MSP-019's bundle
  // support/reflection threads. Reuses Forum, not a parallel comment system.
  reflectionThreadId String? @unique

  @@index([date])
  @@index([isActive])
}

// SHOP_BACKLOG.md MSP-008: "Vendor request flow for seasonal item
// promotions, routed through existing admin review". Also the real
// event<->product relation this item's own notes flagged as missing --
// the "Coming Up" banner's featured-products list can now prefer items
// actually tagged to the nearest event, instead of only ever falling back
// to whatever is generically isFeatured.
model EventProductFeature {
  id              String              @id @default(uuid())
  eventId         String
  productId       String
  vendorId        String
  status          String              @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  requestedAt     DateTime            @default(now())
  reviewedBy      String?
  reviewedAt      DateTime?
  event           SacredCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, productId])
  @@index([eventId])
  @@index([status])
}

// COMMUNITY_BACKLOG.md FOR-013: RSVP + optional intention sharing for a
// SacredCalendarEvent. Deliberately hangs off the existing calendar model
// rather than a new "ritual" concept -- every virtual ritual this session
// scopes to IS a SacredCalendarEvent.
model RitualParticipation {
  id        String              @id @default(uuid())
  eventId   String
  userId    String
  intention String?
  isPublic  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  event     SacredCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                @relation("RitualParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model PlatformSettings {
  id                          String   @id @default("singleton")
  consultationCommissionPct   Decimal  @default(15) @db.Decimal(14, 2)
  marketplaceCommissionPct    Decimal  @default(10) @db.Decimal(14, 2)
  minPayoutThresholdNgn       Decimal  @default(5000) @db.Decimal(14, 2)
  maxPayoutWithoutApprovalNgn Decimal  @default(100000) @db.Decimal(14, 2)
  quizPassThreshold           Int      @default(2)
  // ILUASE_V1_BACKLOG.md 🔴 Critical fix: admin-finance.service.ts used to
  // fabricate this as a "placeholder calculation" derived from commission
  // percentages, presenting a made-up number as real operating cost in the
  // revenue forecast API response. Nullable and no default -- null means
  // "an admin hasn't entered a real figure yet", distinct from a real 0.
  platformCostNgn             Decimal? @db.Decimal(14, 2)
  // ADM-030: last of the "Platform Settings Panel" fields that were
  // actually missing (feature flags and forum limits deliberately not
  // added -- see ILUASE_V1_BACKLOG.md's ADM-030 entry for why; welcome
  // message is already covered by the existing Announcements system).
  // Enforced by MaintenanceModeMiddleware -- /admin, /auth, /health, and
  // /metrics stay reachable so admins can still work and infra monitoring
  // doesn't false-alarm; everything else 503s.
  maintenanceMode             Boolean  @default(false)
  updatedAt                   DateTime @updatedAt
  updatedBy                   String?
}

// ADM-028: Cultural Orientation Quiz
model CulturalQuizQuestion {
  id           String   @id @default(uuid())
  questionText String
  options      Json // String[]
  correctIndex Int
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("cultural_quiz_questions")
}

// ADM-017: Community Recognition System
model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  badgeKey    String // Unique identifier for the badge type
  awardedAt   DateTime @default(now())
  awardedById String?
  reason      String?

  user      User  @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User? @relation("BadgeAwarder", fields: [awardedById], references: [id])

  @@index([userId])
  @@index([badgeKey])
}

// EXP-012: Onboarding completion email tracking
model OnboardingEmail {
  id     String   @id @default(uuid())
  userId String
  email  String // Store email at time of sending (in case user changes it later)
  sentAt DateTime @default(now())

  user User @relation("OnboardingEmailUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
}

// ADM-018: Cultural Integrity Review Queue
model ContentFlagRule {
  id        String   @id @default(uuid())
  type      String // KEYWORD | CATEGORY_MOD
  value     String // keyword text OR categoryId
  reason    String?
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("FlagRuleCreator", fields: [createdBy], references: [id])

  @@index([type, isActive])
}

// ADM-019: Segmented Email Campaigns
model EmailCampaign {
  id             String    @id @default(uuid())
  subject        String
  body           String
  segment        String // ALL | CLIENTS | BABALAWOS | DEVOTED | FREE_TIER | NEW_30D | INACTIVE_30D | COUNTRY_NG | COUNTRY_UK | COUNTRY_US
  status         String    @default("DRAFT") // DRAFT | SENT | SCHEDULED
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  creator User @relation("CampaignCreator", fields: [createdBy], references: [id])

  @@index([status])
  @@index([createdAt])
}

// ADM-020: Promo Code & Discount System
model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String // PCT_SUBSCRIPTION | FIXED_CONSULTATION | FREE_TRIAL_DAYS | REFERRAL_CREDIT
  value         Decimal   @db.Decimal(14, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  eligibleRoles String[]  @default([])
  isActive      Boolean   @default(true)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator     User              @relation("PromoCodeCreator", fields: [createdBy], references: [id])
  redemptions PromoRedemption[]

  @@index([code])
  @@index([isActive])
}

model PromoRedemption {
  id          String   @id @default(uuid())
  promoCodeId String
  userId      String
  redeemedAt  DateTime @default(now())
  discountNgn Decimal  @default(0) @db.Decimal(14, 2)

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation("PromoRedemptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([userId])
}

// ADM-021: Referral Program Management uses the existing Referral model above

// ADM-027: Session & Security Management
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceInfo  String?
  location    String?
  loginAt     DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  loggedOutAt DateTime?
  isActive    Boolean   @default(true)
  success     Boolean   @default(true)
  failReason  String?

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("user_sessions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  role      String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([userId])
}

// Whole-app audit Phase 3c: a Babalawo's own catalog of consultation service
// types (name/price/duration). Previously service-offering-view.tsx was pure
// local useState with no backend at all -- nothing a practitioner "saved"
// here ever persisted.
model ServiceOffering {
  id                String    @id @default(uuid())
  babalawoId        String
  name              String
  description       String
  category          String
  durationMinutes   Int
  priceAmount       Decimal   @db.Decimal(14, 2)
  priceCurrency     String    @default("NGN")
  isActive          Boolean   @default(true)
  maxSessionsPerDay Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  babalawo User @relation("ServiceOfferingBabalawo", fields: [babalawoId], references: [id], onDelete: Cascade)

  @@index([babalawoId])
  @@index([deletedAt])
}
