# Stage 1: Build the NestJS app
FROM node:22-alpine AS builder

WORKDIR /app

# Copy monorepo root manifests
COPY package.json package-lock.json ./

# Copy workspace manifests
COPY common/package.json ./common/package.json
COPY backend/package.json ./backend/package.json

# Stub frontend package so npm workspaces resolves
RUN mkdir -p frontend && echo '{"name":"@ile-ase/frontend","version":"0.1.0","private":true}' > frontend/package.json

# Install deps
RUN npm ci --legacy-peer-deps 2>&1

# Build common package
COPY common ./common
RUN cd common && npx tsc

# Copy backend source
COPY backend ./backend

# Build backend
RUN cd backend && npm run build

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs &&\
    adduser -S nestjs -u 1001

# Stage 2: Create runtime image
FROM node:22-alpine

WORKDIR /app

# Copy built application from builder
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/backend/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/common/dist ./common/dist

# Create non-root user
USER nestjs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD node healthcheck.js

CMD ["node", "dist/src/main.js"]