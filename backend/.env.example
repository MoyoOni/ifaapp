# Backend Environment Variables
# PRODUCTION: All demo mode has been removed. This application only works with real data and APIs.

# Database Configuration
# connection_limit: max connections per Prisma instance (recommended: (num_cpus * 2) + 1)
# pool_timeout: seconds to wait for a connection before failing
DATABASE_URL="postgresql://username:password@localhost:5432/ilease?schema=public&connection_limit=10&pool_timeout=10"

# JWT Configuration (REQUIRED - generate secure random strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-at-least-32-characters"
JWT_REFRESH_SECRET="your-secure-refresh-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=8080
NODE_ENV=production
FRONTEND_URL="https://app.ilu-ase.com"
# Production: comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS="https://app.ilu-ase.com"

# Message Encryption (REQUIRED - must be exactly 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY="your-32-character-encryption-key"

# AWS S3 Configuration (for document uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@ilu-ase.com

# Payment Gateways
PAYSTACK_SECRET_KEY=your-paystack-secret-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key

# V8 Devoted-tier subscriptions (Paystack Plans) -- required for
# POST /subscriptions/initiate and the subscription webhook to work at all.
# Create these two Plans in the Paystack dashboard (Payments -> Plans) --
# QUARTERLY: NGN 25,000 every 3 months; ANNUAL: NGN 100,000 every 12 months
# -- then paste the plan_code Paystack gives you (looks like PLN_xxxxxxxx).
# Without these set, checkout throws instead of silently creating a broken
# one-time charge (see subscriptions.service.ts initiateSubscription).
PAYSTACK_DEVOTED_QUARTERLY_PLAN=your-paystack-quarterly-plan-code
PAYSTACK_DEVOTED_ANNUAL_PLAN=your-paystack-annual-plan-code
# From the same webhook you point at POST /subscriptions/webhook in the
# Paystack dashboard (Settings -> API Keys & Webhooks) -- without this set,
# the webhook refuses to process any event at all (fails closed, not open).
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Video Calls (Agora)
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# Google OAuth (required for "Sign in with Google" server-side token verification)
# Create at https://console.cloud.google.com/apis/credentials — use same Client ID as frontend + secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Error Tracking (REQUIRED in production for Sentry monitoring)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# First-Deploy Admin Bootstrap (only needed once; remove after bootstrap)
# Run: ./scripts/bootstrap-production.sh
BOOTSTRAP_ADMIN_EMAIL=admin@ilu-ase.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately-min-12-chars
