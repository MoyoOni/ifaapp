{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "091653536932.dkr.ecr.us-east-1.amazonaws.com/iluase/backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "https://iluase.com,https://www.iluase.com"
        },
        {
          "name": "API_URL",
          "value": "https://iluase.com/api"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "SENTRY_TRACE_SAMPLE_RATE",
          "value": "0.2"
        },
        {
          "name": "JWT_EXPIRATION",
          "value": "3600"
        },
        {
          "name": "WEBSOCKET_CORS_ORIGIN",
          "value": "https://iluase.com"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "SENTRY_ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "ENABLE_SWAGGER",
          "value": "false"
        },
        {
          "name": "WEBSOCKET_URL",
          "value": "wss://iluase.com"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://iluase.com"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/connection-strings-v5D2pP:DATABASE_URL::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/connection-strings-v5D2pP:REDIS_URL::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:JWT_SECRET::"
        },
        {
          "name": "JWT_REFRESH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:JWT_REFRESH_SECRET::"
        },
        {
          "name": "ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:ENCRYPTION_KEY::"
        },
        {
          "name": "SENTRY_DSN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:SENTRY_DSN::"
        },
        {
          "name": "PAYSTACK_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:PAYSTACK_SECRET_KEY::"
        },
        {
          "name": "FLUTTERWAVE_PUBLIC_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:FLUTTERWAVE_PUBLIC_KEY::"
        },
        {
          "name": "FLUTTERWAVE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:FLUTTERWAVE_SECRET_KEY::"
        },
        {
          "name": "FLUTTERWAVE_SECRET_HASH",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:091653536932:secret:iluase/prod/app-secrets-zmP87y:FLUTTERWAVE_SECRET_HASH::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/iluase-prod/backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "family": "iluase-prod-backend",
  "taskRoleArn": "arn:aws:iam::091653536932:role/iluase-ecs-task-role",
  "networkMode": "awsvpc",
  "cpu": "512",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::091653536932:role/iluase-ecs-task-execution-role"
}
