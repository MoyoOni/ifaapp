# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables (P3-04: wildcard, not a fixed list — the previous
# exact-filename list missed .env.staging, .env.staging.local, and
# scripts/.env.docker, all of which carry real-looking secret values).
# frontend/.env.production is the one intentional exception: it holds only
# VITE_-prefixed values, which Vite bundles into the client and are public by
# construction (Firebase web config, Sentry DSN, OAuth client ID) — not secrets.
.env*
!**/.env*.example
!frontend/.env.production

# AWS IAM access key downloads (e.g. *_accessKeys.csv from the console) —
# plaintext long-lived credentials, must never be committed.
*_accessKeys.csv

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Development logs
*-dev.log
*.log.*
debug.log

