{
  "name": "ifa_monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "npm --prefix common run build && npm --prefix frontend run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "cd frontend && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "frontend",
    "backend",
    "common"
  ],
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.1.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "concurrently": "^8.2.2",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.5",
    "pdfkit": "^0.17.2",
    "rxjs": "^7.8.1",
    "validator": "^13.11.0"
  }
}
