# Docker Compose Environment Variables
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# Then run: docker compose --env-file .env.docker up

# Database
POSTGRES_DB=ilease
POSTGRES_USER=ilease
POSTGRES_PASSWORD=secure_db_password_for_dev_123456

# Authentication (min 32 characters each — use: openssl rand -hex 32)
JWT_SECRET=this_is_a_secure_jwt_secret_for_dev_at_least_32_chars_long
JWT_REFRESH_SECRET=this_is_a_secure_refresh_secret_for_dev_at_least_32_chars
ENCRYPTION_KEY=encrypt_key_for_dev_purposes_32c

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8100