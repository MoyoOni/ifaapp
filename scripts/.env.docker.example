# Docker Compose Environment Variables
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# Then run: docker compose --env-file .env.docker up

# Database
POSTGRES_DB=ilease
POSTGRES_USER=ilease
POSTGRES_PASSWORD=your-secure-db-password-here

# Authentication (min 32 characters each — use: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters

# Encryption (exactly 32 characters — use: openssl rand -hex 16)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8100
