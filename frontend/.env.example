# API Configuration
VITE_API_URL=http://localhost:8080/api

# Demo mode: when true, API failures fall back to demo data (PB-203.3)
# Development: set to true. Production: set to false or omit (errors surface to Sentry)
VITE_DEMO_MODE=true
# Legacy alias (optional)
# VITE_ENABLE_DEMO_MODE=true

# Error Tracking (set in production for Sentry monitoring)
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Google OAuth (required for "Sign in with Google")
# Create at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Third-party Services (if needed on frontend)
# VITE_AGORA_APP_ID=your-agora-app-id
