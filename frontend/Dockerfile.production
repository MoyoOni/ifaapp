# Stage 1: Build the React app
FROM node:22-alpine AS builder

WORKDIR /app

# Copy monorepo root manifests
COPY package.json package-lock.json ./

# Copy workspace manifests
COPY common/package.json ./common/package.json
COPY frontend/package.json ./frontend/package.json

# Stub backend package so npm workspaces resolves
RUN mkdir -p backend && echo '{"name":"@ile-ase/backend","version":"0.1.0","private":true}' > backend/package.json

# Install deps
RUN npm ci --legacy-peer-deps 2>&1

# Build common package
COPY common ./common
RUN cd common && npx tsc

# Copy frontend source
COPY frontend ./frontend

# Build frontend (pass build args as env vars)
#
# frontend/.env.production DOES reach this build (corrected November 26, 2026; this comment used to say it never
# did): the root .dockerignore's `.env` / `.env.*` patterns match only at the context root, not frontend/.env.production,
# which is tracked on purpose (public VITE_ config) and supplies VITE_SENTRY_DSN. The explicit defaults below still
# matter: deploy.sh passes no --build-arg, and an empty VITE_GOOGLE_CLIENT_ID once hid Google Sign-In in production.
#
# VITE_SENTRY_ENABLED=true is what turns Sentry on: only this image (and native store builds) should report to
# production Sentry, never a developer's local `vite build`/`vite preview`.
ARG VITE_API_URL=https://iluase.com/api
ARG VITE_BASE_PATH=/
ARG VITE_GOOGLE_CLIENT_ID=559744613223-klf56010kv4dm2c2lbd3f3imgrmgcls5.apps.googleusercontent.com
ARG VITE_SENTRY_ENABLED=true
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_SENTRY_ENABLED=$VITE_SENTRY_ENABLED

RUN cd frontend && NODE_OPTIONS="--max-old-space-size=4096" npx vite build

# Stage 2: Serve with Nginx (static files only - ALB handles API routing)
FROM nginx:alpine

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.production.conf /etc/nginx/nginx.conf

EXPOSE 80
