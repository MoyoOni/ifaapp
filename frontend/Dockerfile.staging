# Stage 1: Build the React app inside Docker (avoids Windows memory limits)
FROM node:22-alpine AS builder

WORKDIR /app

# Copy monorepo root manifests
COPY package.json package-lock.json ./

# Copy workspace manifests
COPY common/package.json ./common/package.json
COPY frontend/package.json ./frontend/package.json

# Stub backend package so npm workspaces resolves
RUN mkdir -p backend && echo '{"name":"@ile-ase/backend","version":"0.1.0","private":true}' > backend/package.json

# Install deps
RUN npm ci --legacy-peer-deps 2>&1

# Build common package
COPY common ./common
RUN cd common && npx tsc

# Copy frontend source
COPY frontend ./frontend

# Build frontend (pass build args as env vars)
ARG VITE_API_URL=http://localhost:8080/api
ARG VITE_BASE_PATH=/
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN cd frontend && NODE_OPTIONS="--max-old-space-size=4096" npx vite build

# Stage 2: Serve with Nginx
FROM nginx:alpine

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx.staging.conf /etc/nginx/nginx.conf

EXPOSE 80
