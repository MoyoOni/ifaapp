{
  "permissions": {
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(grep * .env*)",
      "Bash(grep * */.env*)",
      "Bash(find * -exec cat *)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws secretsmanager:*)"
    ]
  }
}
