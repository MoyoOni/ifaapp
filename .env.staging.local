# ⚠️ DO NOT COMMIT TO GIT - Contains secrets!

# ============================================
# INFRASTRUCTURE & DEPLOYMENT
# ============================================
NODE_ENV=production
LOG_LEVEL=info
ENVIRONMENT=staging

# ============================================
# DATABASE
# ============================================
POSTGRES_DB=ilu_ase_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=Staging_DB_Pass_2026_Secure_xyz789
DATABASE_URL=postgresql://staging_user:Staging_DB_Pass_2026_Secure_xyz789@postgres:5432/ilu_ase_staging?schema=public&connection_limit=10

# ============================================
# REDIS CACHE
# ============================================
REDIS_PASSWORD=Staging_Redis_Pass_2026_Secure_abc123
REDIS_URL=redis://:Staging_Redis_Pass_2026_Secure_abc123@redis:6379

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=Staging_JWT_Secret_2026_MinimumThirtyTwoCharacters_xyz
JWT_EXPIRATION=3600

# ============================================
# PAYMENT PROCESSING - STRIPE TEST KEYS
# ============================================
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnop
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijklmnop
STRIPE_WEBHOOK_SECRET=whsec_test_1234567890abcdefghijklmnop

# ============================================
# ERROR TRACKING & MONITORING
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACE_SAMPLE_RATE=0.5
SENTRY_ENABLED=false

# ============================================
# URLS & ORIGINS
# ============================================
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4040
WEBSOCKET_URL=ws://localhost:8080
WEBSOCKET_CORS_ORIGIN=http://localhost:4040

# ============================================
# API DOCUMENTATION
# ============================================
ENABLE_SWAGGER=true
SWAGGER_PATH=/api/docs

# ============================================
# GOOGLE OAUTH
# ============================================
VITE_GOOGLE_CLIENT_ID=559744613223-klf56010kv4dm2c2lbd3f3imgrmgcls5.apps.googleusercontent.com
